diff --git a/src/keymgr_openssl.c b/src/keymgr_openssl.c
--- a/src/keymgr_openssl.c
+++ b/src/keymgr_openssl.c
@@ -1116,10 +1116,17 @@
 {
 	int		fd;
 	ssize_t		ret;
+	char		*pending;
+	size_t		capacity;
 
