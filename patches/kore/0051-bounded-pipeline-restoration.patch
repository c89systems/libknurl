+size_t
+kore_library_http_pipeline_read(struct connection *c, void *buffer, size_t capacity)
+{
+	size_t count;
+	count = MIN(capacity, c->http_pipeline_len);
+	if (count == 0)
+		return (0);
+	memcpy(buffer, c->http_pipeline, count);
+	c->http_pipeline_len -= count;
+	if (c->http_pipeline_len != 0)
+		memmove(c->http_pipeline, c->http_pipeline + count,
+		    c->http_pipeline_len);
+	else {
+		kore_free(c->http_pipeline);
+		c->http_pipeline = NULL;
+	}
+	return (count);
+}
