+/* Decimal conversion without C99 printf length modifiers on 32-bit targets.
+ * Callers supply 21 bytes for unsigned, 22 bytes for signed values.
+ */
+char *
+kore_u64_text(u_int64_t value, char *output)
+{
+    char reverse[20];
+    size_t used, index;
+    used = 0;
+    do {
+        reverse[used++] = (char)('0' + value % 10);
+        value /= 10;
+    } while (value != 0);
+    for (index = 0; index < used; index++)
+        output[index] = reverse[used - index - 1];
+    output[used] = '\0';
+    return (output);
+}
+
+char *
+kore_i64_text(int64_t value, char *output)
+{
+    if (value < 0) {
+        output[0] = '-';
+        (void)kore_u64_text((u_int64_t)(-(value + 1)) + 1, output + 1);
+        return (output);
+    }
+    return (kore_u64_text((u_int64_t)value, output));
+}
