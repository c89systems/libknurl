+int
+kore_library_watch_update(int fd, unsigned int previous,
+    unsigned int interest, void *userdata)
+{
+	struct epoll_event event;
+	int operation;
+	if (previous == interest)
+		return (0);
+	memset(&event, 0, sizeof(event));
+	if (interest & 1U)
+		event.events |= EPOLLIN | EPOLLRDHUP;
+	if (interest & 2U)
+		event.events |= EPOLLOUT;
+	event.data.ptr = userdata;
+	if (interest == 0)
+		operation = EPOLL_CTL_DEL;
+	else
+		operation = previous == 0 ? EPOLL_CTL_ADD : EPOLL_CTL_MOD;
+	if (epoll_ctl(efd, operation, fd, &event) == 0)
+		return (0);
+	if (interest == 0 && (errno == ENOENT || errno == EBADF))
+		return (0);
+	return (errno);
 }
 
