+int
+kore_library_watch_update(int fd, unsigned int previous,
+    unsigned int interest, void *userdata)
+{
+	struct kevent event;
+	int filters[2];
+	unsigned int bit, index, rollback;
+	int flags, saved;
+	filters[0] = EVFILT_READ;
+	filters[1] = EVFILT_WRITE;
+	for (index = 0; index < 2; index++) {
+		bit = 1U << index;
+		if ((previous & bit) == (interest & bit))
+			continue;
+		flags = (interest & bit) ? EV_ADD | EV_ENABLE : EV_DELETE;
+		EV_SET(&event, fd, filters[index], flags, 0, 0, userdata);
+		if (kevent(kfd, &event, 1, NULL, 0, NULL) == 0 ||
+		    ((flags & EV_DELETE) && (errno == ENOENT || errno == EBADF)))
+			continue;
+		saved = errno;
+		for (rollback = 0; rollback < index; rollback++) {
+			bit = 1U << rollback;
+			if ((previous & bit) == (interest & bit))
+				continue;
+			flags = (previous & bit) ? EV_ADD | EV_ENABLE : EV_DELETE;
+			EV_SET(&event, fd, filters[rollback], flags, 0, 0, userdata);
+			(void)kevent(kfd, &event, 1, NULL, 0, NULL);
+		}
+		return (saved);
+	}
+	return (0);
+}
