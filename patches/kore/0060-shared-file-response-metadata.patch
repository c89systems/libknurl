+/* Shared with managed file replies; callers retain their own file/queue owner. */
+int
+http_response_file_metadata(struct http_request *req, time_t modified,
+    char *stamp, size_t capacity)
+{
+	struct tm *tm;
+	const char *value;
+
+	stamp[0] = '\0';
+	if (http_request_header(req, "if-modified-since", &value) &&
+	    kore_date_to_time(value) == modified)
+		return (HTTP_STATUS_NOT_MODIFIED);
+	if ((tm = gmtime(&modified)) != NULL &&
+	    strftime(stamp, capacity, "%a, %d %b %Y %H:%M:%S GMT", tm) == 0)
+		stamp[0] = '\0';
+	return (0);
+}
