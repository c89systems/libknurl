+kore_library_parent_start(void)
+{
+    u_int32_t maximum;
+    int started;
+    kore_keymgr_active = acme_domains != 0;
+    library_initialized |= LIB_WORKERS;
+    started = kore_worker_init();
+    maximum = worker_max_connections;
+    worker_max_connections = worker_count;
+    library_initialized |= LIB_NETWORK;
+    net_init();
+    library_initialized |= LIB_CONNECTIONS;
+    kore_connection_init();
+    library_initialized |= LIB_EVENTS;
+    kore_platform_event_init();
+    kore_msg_parent_init();
+    worker_max_connections = maximum;
+    kore_timer_init();
+    return (started);
+}
+
+void
+kore_library_parent_step(u_int64_t maximum_wait)
+{
+    u_int64_t wait;
+    wait = kore_timer_next_run(kore_time_ms());
+    if (wait > maximum_wait)
+        wait = maximum_wait;
+    kore_platform_event_wait(wait);
+    kore_connection_prune(KORE_CONNECTION_PRUNE_DISCONNECT);
+    kore_timer_run(kore_time_ms());
+    kore_worker_reap();
+}
+
+void
+kore_library_cleanup(void)
+{
+    if ((library_initialized & LIB_WORKERS) && kore_worker_available()) {
+        kore_worker_dispatch_signal(SIGQUIT);
+        kore_worker_shutdown();
+    }
+    if (library_initialized & LIB_WORKERS)
+        kore_worker_parent_cleanup();
+    if (library_initialized & LIB_CONNECTIONS)
+        kore_connection_cleanup();
+    if (library_initialized & LIB_EVENTS)
+        kore_platform_event_cleanup();
+    kore_server_cleanup();
+    kore_domain_cleanup();
+    kore_tls_cleanup();
+    if (library_initialized & LIB_NETWORK)
+        net_cleanup();
+    if (library_initialized & LIB_CURL)
+        kore_curl_syscleanup();
+    kore_timer_cleanup();
+    if (library_initialized & LIB_HTTP) {
+        kore_accesslog_cleanup();
+        http_parent_cleanup();
+    }
+    if (library_initialized & LIB_MESSAGES)
+        kore_msg_cleanup();
+    kore_free(kore_progname);
+    kore_progname = NULL;
+    kore_log_set_logger(NULL);
+    if (library_initialized & LIB_MEMORY)
+        kore_mem_cleanup();
+    library_initialized = 0;
+}
