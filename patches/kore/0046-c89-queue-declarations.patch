+#ifndef KORE_QUEUE_H
+#define KORE_QUEUE_H
+
+#include <sys/queue.h>
+
+/* Some system headers implement these through an empty qualifier argument,
+ * which Clang correctly diagnoses in C89. Preserve the BSD queue layout while
+ * keeping these declaration macros and their named callers valid C89.
+ * All queue operations continue to use the platform definitions.
+ */
+#undef TAILQ_HEAD
+#define TAILQ_HEAD(name, type) \
+struct name { \
+    struct type *tqh_first; \
+    struct type **tqh_last; \
+}
+
+#undef TAILQ_ENTRY
+#define TAILQ_ENTRY(type) \
+struct { \
+    struct type *tqe_next; \
+    struct type **tqe_prev; \
+}
+
+#endif
