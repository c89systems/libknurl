+static void
+acme_challenge_ready(struct kore_msg *msg, const void *data)
+{
+	struct acme_order *order;
+	struct acme_auth *auth;
+	struct acme_challenge *challenge;
+	const struct kore_x509_msg *req;
+	const unsigned char *cursor, *digest;
+	X509 *certificate;
+	ASN1_OBJECT *oid;
+	X509_EXTENSION *extension;
+	ASN1_OCTET_STRING *value;
+	int index;
+	if (msg->src == 0 || msg->src >= KORE_WORKER_MAX ||
+	    msg->src > worker_count - 2 ||
+	    !kore_worker_keymgr_response_verify(msg, data, NULL))
+		return;
+	req = data;
+	cursor = req->data;
+	certificate = d2i_X509(NULL, &cursor, req->data_len);
+	if (certificate == NULL)
+		return;
+	oid = OBJ_txt2obj("1.3.6.1.5.5.7.1.31", 1);
+	index = X509_get_ext_by_OBJ(certificate, oid, -1);
+	ASN1_OBJECT_free(oid);
+	extension = index >= 0 ? X509_get_ext(certificate, index) : NULL;
+	value = extension != NULL ? X509_EXTENSION_get_data(extension) : NULL;
+	if (value == NULL || ASN1_STRING_length(value) != 34) {
+		X509_free(certificate);
+		return;
+	}
+	digest = ASN1_STRING_get0_data(value) + 2;
+	LIST_FOREACH(order, &orders, list) {
+		if (strcmp(order->domain, req->domain))
+			continue;
+		LIST_FOREACH(auth, &order->auth, list) {
+			challenge = auth->challenge;
+			if (challenge == NULL || !(challenge->flags & ACME_FLAG_CHALLENGE_CREATED) ||
+			    challenge->ready[msg->src] ||
+			    memcmp(challenge->digest, digest, SHA256_DIGEST_LENGTH))
+				continue;
+			challenge->ready[msg->src] = 1;
+			if (++challenge->ready_count == (unsigned int)(worker_count - 2))
+				acme_challenge_respond(order, challenge->url, "tls-alpn-01");
+		}
+	}
+	X509_free(certificate);
 }
 
