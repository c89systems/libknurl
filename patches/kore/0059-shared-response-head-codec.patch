+/* One codec serves normal Kore responses and the library's bounded sender.
+ * It builds bytes only; the caller owns queueing and connection teardown. */
+int
+http_response_head_build(struct http_request *req, struct connection *c,
+    int status, int flags, u_int64_t len,
+    const struct http_response_field *extra, size_t count, struct kore_buf *out)
+{
+	struct http_cookie *ck;
+	struct http_header *hdr;
+	size_t i;
+	char version, number[21];
+	const char *conn;
+	int connection_close, skip;
+
+	kore_buf_reset(out);
+	version = req != NULL && (req->flags & HTTP_VERSION_1_0) ? '0' : '1';
+	kore_buf_appendf(out, "HTTP/1.%c %d %s\r\n", version, status,
+	    http_status_text(status));
+	if (status == 100) {
+		kore_buf_append(out, "\r\n", 2);
+		if (!(flags & HTTP_RESPONSE_HEAD_COUNTED))
+			return ((flags & HTTP_RESPONSE_HEAD_CLOSE) != 0);
+	}
+	if (status != 100)
+		kore_buf_append(out, http_version, http_version_len);
+	connection_close = (flags & HTTP_RESPONSE_HEAD_CLOSE) ||
+	    (c->flags & CONN_CLOSE_EMPTY) || version == '0';
+	if (req != NULL && !(flags & HTTP_RESPONSE_HEAD_COUNTED))
+		c->http_response_count++;
+	if (!connection_close && req != NULL &&
+	    http_request_header(req, "connection", &conn) &&
+	    (*conn == 'c' || *conn == 'C') && !strcasecmp(conn, "close"))
+		connection_close = 1;
+	if (c->proto != CONN_PROTO_WEBSOCKET &&
+	    !(flags & HTTP_RESPONSE_HEAD_UPGRADE)) {
+		if (req != NULL && http_keepalive_max_requests > 0 &&
+		    c->http_response_count >= http_keepalive_max_requests)
+			connection_close = 1;
+		if (http_keepalive_time && !connection_close) {
+			if (status != 100) {
+				kore_buf_appendf(out, "connection: keep-alive\r\n");
+				kore_buf_appendf(out, "keep-alive: timeout=%d\r\n",
+				    http_keepalive_time);
+			}
+		} else {
+			connection_close = 1;
+			if (status != 100)
+				kore_buf_appendf(out, "connection: close\r\n");
+		}
+	} else {
+		connection_close = 0;
+	}
+	if (status == 100)
+		return (connection_close);
+	if (c->tls && http_hsts_enable)
+		kore_buf_appendf(out, "strict-transport-security: "
+		    "max-age=%s; includeSubDomains\r\n",
+		    kore_u64_text(http_hsts_enable, number));
+	if (req != NULL) {
+		TAILQ_FOREACH(ck, &req->resp_cookies, list)
+			http_write_response_cookie(ck, out);
+		TAILQ_FOREACH(hdr, &req->resp_headers, list) {
+			skip = 0;
+			for (i = 0; i < count; i++) {
+				if (strcasecmp(extra[i].name, "set-cookie") &&
+				    !strcasecmp(extra[i].name, hdr->header)) {
+					skip = 1;
+					break;
+				}
+			}
+			if (!skip)
+				kore_buf_appendf(out, "%s: %s\r\n",
+				    hdr->header, hdr->value);
+		}
+	}
+	for (i = 0; i < count; i++)
+		kore_buf_appendf(out, "%s: %s\r\n", extra[i].name, extra[i].value);
+	if (req != NULL && req->rt != NULL && req->rt->dom != NULL) {
+		TAILQ_FOREACH(hdr, &req->rt->dom->headers, list)
+			kore_buf_appendf(out, "%s: %s\r\n", hdr->header, hdr->value);
+	}
+	if (status >= 200 && status != 204 &&
+	    !(flags & HTTP_RESPONSE_HEAD_NO_LENGTH))
+		kore_buf_appendf(out, "content-length: %s\r\n",
+		    kore_u64_text(len, number));
+	kore_buf_append(out, "\r\n", 2);
+	return (connection_close);
+}
