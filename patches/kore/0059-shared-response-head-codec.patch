+int
+http_response_error_body(int status, struct kore_buf *out)
+{
+	const char *text;
+
+	if (!http_pretty_error || status < 400)
+		return (0);
+	text = http_status_text(status);
+	kore_buf_appendf(out, pretty_error_fmt, status, text, status, text);
+	return (1);
+}
