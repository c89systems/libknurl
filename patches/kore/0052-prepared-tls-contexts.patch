+/* Takes a prepared context. Its material, bounds and protocol policy were
+ * validated by the library adapter without a private-key file. */
+void
+kore_library_tls_context_install(struct kore_domain *dom, SSL_CTX *ctx)
+{
+	if (dom->tls_ctx != NULL)
+		SSL_CTX_free(dom->tls_ctx);
+	dom->tls_ctx = ctx;
+	SSL_CTX_set_info_callback(ctx, tls_info_callback);
+	SSL_CTX_set_tlsext_servername_callback(ctx, tls_sni_cb);
+#if defined(KORE_USE_ACME)
+	SSL_CTX_set_alpn_select_cb(ctx, tls_acme_alpn, dom);
+#endif
+}
