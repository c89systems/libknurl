+
+void
+kore_library_worker_deadline(u_int32_t milliseconds)
+{
+	if (worker == NULL || milliseconds > 0x7fffffffUL)
+		fatal("invalid dedicated child operation deadline");
+	__atomic_store_n(&worker->library_deadline_active, 0, __ATOMIC_RELEASE);
+	__atomic_store_n(&worker->library_deadline,
+	    (u_int32_t)kore_time_ms() + milliseconds, __ATOMIC_RELEASE);
+	__atomic_store_n(&worker->library_deadline_active,
+	    milliseconds != 0, __ATOMIC_RELEASE);
+	if (worker->msg[1] != NULL)
+		kore_msg_send(KORE_MSG_PARENT, KORE_MSG_LIBRARY_DEADLINE, NULL, 0);
+}
+
+static int
+worker_deadline_check(struct kore_worker *kw, u_int32_t now)
+{
+	u_int32_t left;
+	if (!__atomic_load_n(&kw->library_deadline_active, __ATOMIC_ACQUIRE) ||
+	    kw->pid <= 0 || !kw->running || kw->library_timed_out)
+		return (0);
+	left = __atomic_load_n(&kw->library_deadline, __ATOMIC_ACQUIRE) - now;
+	if (left != 0 && left <= 0x7fffffffUL)
+		return (0);
+	kw->library_timed_out = 1;
+	kore_library_escalated = 1;
+	__atomic_store_n(&kw->library_deadline_active, 0, __ATOMIC_RELEASE);
+	worker_library_event(kw, KORE_LIBRARY_WORKER_ESCALATED, 0,
+	    kore_quit != KORE_QUIT_NONE, 1);
+	(void)kill(kw->pid, SIGKILL);
+	return (1);
+}
+
+u_int64_t
+kore_library_workers_wait(u_int64_t maximum)
+{
+	u_int16_t index;
+	u_int32_t now, left;
+	struct kore_worker *kw;
+	if (kore_workers == NULL)
+		return (maximum);
+	now = (u_int32_t)kore_time_ms();
+	for (index = 0; index < worker_count; index++) {
+		kw = WORKER(index);
+		if (worker_deadline_check(kw, now))
+			return (0);
+		if (!__atomic_load_n(&kw->library_deadline_active, __ATOMIC_ACQUIRE) ||
+		    kw->pid <= 0 || !kw->running)
+			continue;
+		left = __atomic_load_n(&kw->library_deadline, __ATOMIC_ACQUIRE) - now;
+		if (left > 0x7fffffffUL)
+			left = 0;
+		if (left < maximum)
+			maximum = left;
+	}
+	return (maximum);
+}
