@@ -257,6 +257,7 @@
 #define HTTP_REQUEST_RETAIN_EXTRA	0x0040
 #define HTTP_REQUEST_NO_CONTENT_LENGTH	0x0080
 #define HTTP_REQUEST_AUTHED		0x0100
+#define HTTP_REQUEST_LIBRARY_MANAGED	0x0200
 
