--- a/src/http.c
+++ b/src/http.c
@@ -412,6 +412,13 @@
 		fatal("A page handler returned an unknown result: %d", r);
 	}
 
+	/* The library owns request lifetime through asynchronous response drain. */
+	if ((req->flags & HTTP_REQUEST_LIBRARY_MANAGED) &&
+	    !(req->flags & HTTP_REQUEST_DELETE)) {
+		http_request_sleep(req);
+		return;
+	}
+
 	if (req->rt->dom->accesslog || kore_accesslog_enabled())
 		kore_accesslog(req);
 
@@ -461,6 +468,14 @@
 	struct http_arg		*q, *qnext;
 	struct http_header	*hdr, *next;
 	struct http_cookie	*ck, *cknext;
+
+	if ((req->flags & HTTP_REQUEST_LIBRARY_MANAGED) &&
+	    kore_library_hooks.request_release != NULL &&
+	    !kore_library_hooks.request_release(kore_library_hooks.arg, req)) {
+		req->flags &= ~HTTP_REQUEST_DELETE;
+		http_request_sleep(req);
+		return;
+	}
 
 	if (req->rt != NULL && req->rt->on_free != NULL)
 		kore_runtime_http_request_free(req->rt->on_free, req);
