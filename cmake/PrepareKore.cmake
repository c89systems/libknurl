cmake_minimum_required(VERSION 3.21)

foreach(required KORE_SOURCE KORE_PATCHES KORE_OUTPUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Set ${required} before preparing Kore")
  endif()
endforeach()
get_filename_component(knurl_root "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
include("${knurl_root}/cmake/OwnedPaths.cmake")
set(build_root "${knurl_root}/build")
cmake_path(ABSOLUTE_PATH KORE_OUTPUT OUTPUT_VARIABLE raw_output)
cmake_path(NORMAL_PATH raw_output OUTPUT_VARIABLE output)
cmake_path(IS_PREFIX build_root "${output}" NORMALIZE owned)
if(NOT owned OR output STREQUAL build_root)
  message(FATAL_ERROR "KORE_OUTPUT must be a directory below ${build_root}")
endif()
knurl_require_owned_path("${raw_output}" "KORE_OUTPUT")
set(staging "${output}.staging")
knurl_require_owned_path("${staging}" "Kore staging directory")
file(REAL_PATH "${KORE_SOURCE}" source)
cmake_path(IS_PREFIX knurl_root "${source}" NORMALIZE source_owned)
if(NOT source_owned OR NOT EXISTS "${source}/src/kore.c" OR EXISTS "${source}/.git")
  message(FATAL_ERROR "KORE_SOURCE must be a pristine source export, separate from KORE_OUTPUT")
endif()
file(REAL_PATH "${KORE_PATCHES}" patches)
cmake_path(IS_PREFIX knurl_root "${patches}" NORMALIZE patches_owned)
if(NOT patches_owned OR NOT EXISTS "${patches}/series")
  message(FATAL_ERROR "KORE_PATCHES must contain a patch series from this checkout")
endif()
if(IS_SYMLINK "${patches}/series")
  message(FATAL_ERROR "Kore patch series must not be a symlink")
endif()
foreach(input "${source}" "${patches}")
  foreach(destination "${output}" "${staging}")
    cmake_path(IS_PREFIX input "${destination}" NORMALIZE overlaps)
    cmake_path(IS_PREFIX destination "${input}" NORMALIZE contains_input)
    if(overlaps OR contains_input)
      message(FATAL_ERROR "Kore input and generated directories must not overlap: ${input}, ${destination}")
    endif()
  endforeach()
endforeach()
if(NOT GIT_EXECUTABLE)
  find_program(GIT_EXECUTABLE git REQUIRED)
endif()

# Only complete preparations have a stamp. Never expose a partly applied tree.
file(REMOVE "${output}/.patched")
file(REMOVE_RECURSE "${staging}")
file(MAKE_DIRECTORY "${staging}")
file(COPY "${source}/" DESTINATION "${staging}")

function(kore_failure reason)
  file(REMOVE_RECURSE "${staging}")
  message(FATAL_ERROR "${reason}")
endfunction()

file(STRINGS "${patches}/series" series)
set(applied)
foreach(patch IN LISTS series)
  string(STRIP "${patch}" patch)
  if(patch STREQUAL "" OR patch MATCHES "^#")
    continue()
  endif()
  if(NOT patch MATCHES "^[a-zA-Z0-9][a-zA-Z0-9._-]*\\.patch$")
    kore_failure("Invalid patch filename in series: ${patch}")
  endif()
  if(patch IN_LIST applied)
    kore_failure("Duplicate patch in series: ${patch}")
  endif()
  if(IS_SYMLINK "${patches}/${patch}")
    kore_failure("Kore patch must not be a symlink: ${patch}")
  endif()
  if(NOT EXISTS "${patches}/${patch}")
    kore_failure("Missing Kore patch: ${patches}/${patch}")
  endif()
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE
      "GIT_CEILING_DIRECTORIES=${knurl_root}"
      "${GIT_EXECUTABLE}" -C "${staging}" apply "${patches}/${patch}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output_log ERROR_VARIABLE error_log)
  if(NOT result EQUAL 0)
    kore_failure("Kore patch failed: ${patch}\n${output_log}${error_log}")
  endif()
  list(APPEND applied "${patch}")
endforeach()

file(REMOVE_RECURSE "${output}")
file(RENAME "${staging}" "${output}")
file(WRITE "${output}/.patched" "Ordered Kore patch series applied successfully.\n")
list(LENGTH applied patch_count)
message(STATUS "Applied ${patch_count} Kore patches to ${output}")
