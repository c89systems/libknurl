cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
include("${root}/cmake/OwnedPaths.cmake")
include("${root}/cmake/Privacy.cmake")
include("${root}/cmake/Version.cmake")
knurl_version("${root}" version)
knurl_require_owned_path("${PRODUCT_DIR}" "Lua products")
if(NOT VERIFY_DIR)
  set(VERIFY_DIR "${root}/build/lua-verification")
endif()
knurl_require_owned_path("${VERIFY_DIR}" "Lua verification workspace")
cmake_path(IS_PREFIX VERIFY_DIR "${PRODUCT_DIR}" NORMALIZE contains_products)
cmake_path(IS_PREFIX PRODUCT_DIR "${VERIFY_DIR}" NORMALIZE contains_workspace)
if(contains_products OR contains_workspace)
  message(FATAL_ERROR "Lua products and verification workspace must be separate")
endif()
set(package "lua-knurl-${version}")
set(expected "${package}.tar.gz" "${package}-1.rockspec" "${package}-1.src.rock")
file(STRINGS "${PRODUCT_DIR}/${package}-CHECKSUMS" inventory)
set(actual)
foreach(name IN LISTS expected)
  file(SHA256 "${PRODUCT_DIR}/${name}" digest)
  list(APPEND actual "${digest}  ${name}")
endforeach()
if(NOT actual STREQUAL inventory)
  message(FATAL_ERROR "Lua product checksum inventory does not match")
endif()
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Lua artifact command failed: ${errors}")
  endif()
  set(command_output "${log}" PARENT_SCOPE)
endfunction()
# Only these two declared archive levels exist: the source tar and the source
# rock containing that exact tar plus its rockspec. No generic archive recursion.
run("${CMAKE_COMMAND}" -E tar tf "${PRODUCT_DIR}/${package}.tar.gz")
string(REPLACE "\n" ";" entries "${command_output}")
foreach(entry IN LISTS entries)
  if(NOT entry STREQUAL "" AND
      (NOT entry MATCHES "^${package}/" OR entry MATCHES "(^|/)[.][.](/|$)"))
    message(FATAL_ERROR "Unexpected Lua source archive entry")
  endif()
endforeach()
file(REMOVE_RECURSE "${VERIFY_DIR}")
file(MAKE_DIRECTORY "${VERIFY_DIR}/source" "${VERIFY_DIR}/rock")
file(ARCHIVE_EXTRACT INPUT "${PRODUCT_DIR}/${package}.tar.gz" DESTINATION "${VERIFY_DIR}/source")
set(source "${VERIFY_DIR}/source/${package}")
file(STRINGS "${root}/lua/source-manifest.txt" inputs)
file(STRINGS "${source}/lua/source-manifest.txt" declared)
if(NOT inputs STREQUAL declared)
  message(FATAL_ERROR "Unexpected Lua source manifest")
endif()
file(STRINGS "${source}/RELEASE_MANIFEST" records)
set(actual)
foreach(input IN LISTS inputs)
  file(SHA256 "${source}/${input}" digest)
  list(APPEND actual "${digest}  ${input}")
endforeach()
if(NOT actual STREQUAL records)
  message(FATAL_ERROR "Lua source release manifest does not match")
endif()
list(APPEND inputs RELEASE_MANIFEST)
file(GLOB_RECURSE payload LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/*")
list(SORT payload)
list(SORT inputs)
if(NOT payload STREQUAL inputs)
  message(FATAL_ERROR "Unexpected Lua source payload")
endif()
foreach(input IN LISTS inputs)
  file(REAL_PATH "${source}/${input}" physical)
  if(NOT physical STREQUAL "${source}/${input}")
    message(FATAL_ERROR "Lua source payload must not traverse a symlink")
  endif()
  knurl_verify_private_bytes("${source}/${input}")
endforeach()
knurl_verify_private_bytes("${PRODUCT_DIR}/${package}-1.rockspec")
run("${CMAKE_COMMAND}" -E tar tf "${PRODUCT_DIR}/${package}-1.src.rock")
string(STRIP "${command_output}" command_output)
string(REPLACE "\n" ";" entries "${command_output}")
list(SORT entries)
set(expected "${package}-1.rockspec" "${package}.tar.gz")
if(NOT entries STREQUAL expected)
  message(FATAL_ERROR "Unexpected source-rock payload")
endif()
file(ARCHIVE_EXTRACT INPUT "${PRODUCT_DIR}/${package}-1.src.rock" DESTINATION "${VERIFY_DIR}/rock")
knurl_verify_private_bytes("${VERIFY_DIR}/rock/${package}-1.rockspec")
foreach(name IN LISTS expected)
  if(IS_SYMLINK "${VERIFY_DIR}/rock/${name}")
    message(FATAL_ERROR "Source-rock payload must not be a symlink")
  endif()
  run("${CMAKE_COMMAND}" -E compare_files "${PRODUCT_DIR}/${name}" "${VERIFY_DIR}/rock/${name}")
endforeach()
message(STATUS "Verified Lua source, rockspec and nested source-rock bytes: ${version}")
