cmake_minimum_required(VERSION 3.21)

function(rotmos_require_owned_path path label)
  get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." REALPATH)
  if(NOT IS_ABSOLUTE "${path}")
    message(FATAL_ERROR "${label} must be absolute: ${path}")
  endif()
  cmake_path(NORMAL_PATH path OUTPUT_VARIABLE normalized)
  set(owned FALSE)
  foreach(directory build .cache dist)
    set(boundary "${root}/${directory}")
    cmake_path(IS_PREFIX boundary "${normalized}" NORMALIZE inside)
    if(inside)
      set(owned TRUE)
    endif()
  endforeach()
  set(ancestor "${normalized}")
  while(NOT EXISTS "${ancestor}" AND NOT IS_SYMLINK "${ancestor}")
    get_filename_component(ancestor "${ancestor}" DIRECTORY)
  endwhile()
  file(REAL_PATH "${ancestor}" physical)
  if(NOT owned OR NOT ancestor STREQUAL physical)
    message(FATAL_ERROR "${label} must use this checkout's build/, .cache/ or dist/: ${path}")
  endif()
endfunction()

if(DEFINED ROTMOS_CHECK_PATH)
  rotmos_require_owned_path("${ROTMOS_CHECK_PATH}" "Generated path")
endif()
