cmake_minimum_required(VERSION 3.21)

function(knurl_require_owned_path path label)
  get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." REALPATH)
  if(NOT IS_ABSOLUTE "${path}")
    message(FATAL_ERROR "${label} must be absolute: ${path}")
  endif()
  cmake_path(NORMAL_PATH path OUTPUT_VARIABLE normalized)
  set(owned FALSE)
  foreach(directory build .cache dist)
    set(boundary "${root}/${directory}")
    cmake_path(IS_PREFIX boundary "${normalized}" NORMALIZE inside)
    if(inside)
      set(owned TRUE)
    endif()
  endforeach()
  # Inspect raw ancestors before normalizing: link/../output can otherwise hide
  # a symlink escape. This also works with CMake versions before CMP0152.
  set(ancestor "${path}")
  while(TRUE)
    if(IS_SYMLINK "${ancestor}")
      message(FATAL_ERROR "${label} must not traverse a symlink: ${path}")
    endif()
    set(previous "${ancestor}")
    cmake_path(GET ancestor PARENT_PATH ancestor)
    if(ancestor STREQUAL previous)
      break()
    endif()
  endwhile()
  if(NOT owned)
    message(FATAL_ERROR "${label} must use this checkout's build/, .cache/ or dist/: ${path}")
  endif()
endfunction()

if(DEFINED KNURL_CHECK_PATH)
  knurl_require_owned_path("${KNURL_CHECK_PATH}" "Generated path")
endif()
