cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
include("${root}/cmake/OwnedPaths.cmake")
if(NOT BUILD_DIR)
  message(FATAL_ERROR "Provide the configured selected-target BUILD_DIR")
endif()
knurl_require_owned_path("${BUILD_DIR}" "SDK build")
include("${BUILD_DIR}/sdk-build.cmake")
if(NOT SDK_ROOT STREQUAL root OR NOT SDK_BINARY STREQUAL BUILD_DIR)
  message(FATAL_ERROR "SDK build belongs to a different checkout/build")
endif()
if(NOT OUTPUT_DIR)
  set(OUTPUT_DIR "${BUILD_DIR}/packages")
endif()
knurl_require_owned_path("${OUTPUT_DIR}" "SDK package output")
set(binary_root "${root}/build")
cmake_path(IS_PREFIX binary_root "${OUTPUT_DIR}" NORMALIZE binary_output)
if(NOT binary_output)
  message(FATAL_ERROR "SDK binary rehearsals must stay under this checkout's build/")
endif()
set(work "${BUILD_DIR}/package-stage")
set(package "libknurl-${SDK_VERSION}-${SDK_TARGET}")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/${package}" "${OUTPUT_DIR}")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "SDK package command failed: ${ARGV}\n${output}${errors}")
  endif()
endfunction()
run("${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${work}/${package}")
# Remove debug sections from shipped archives too; cmake --install --strip only
# handles shared libraries. Keep all link symbols. Darwin shared images are not
# post-mutated (install_name/strip can invalidate their signatures).
if(SDK_PLATFORM STREQUAL "Darwin")
  run("${CMAKE_COMMAND}" -E env ZERO_AR_DATE=1
    "${SDK_STRIP}" -S "${work}/${package}/lib/libknurl.a")
else()
  run("${SDK_STRIP}" --enable-deterministic-archives --strip-debug "${work}/${package}/lib/libknurl.a")
  run("${SDK_STRIP}" --strip-debug "${work}/${package}/lib/libknurl.so.${SDK_VERSION}")
endif()
file(GLOB_RECURSE payload LIST_DIRECTORIES FALSE RELATIVE "${work}/${package}" "${work}/${package}/*")
list(SORT payload)
set(manifest "")
foreach(path IN LISTS payload)
  if(IS_SYMLINK "${work}/${package}/${path}")
    file(READ_SYMLINK "${work}/${package}/${path}" link)
    if(IS_ABSOLUTE "${link}" OR link MATCHES "(^|/)[.][.](/|$)")
      message(FATAL_ERROR "Nonlocal SDK symlink: ${path} -> ${link}")
    endif()
    string(SHA256 digest "symlink:${link}")
  else()
    file(SHA256 "${work}/${package}/${path}" digest)
  endif()
  string(APPEND manifest "${digest}  ${path}\n")
endforeach()
file(WRITE "${work}/${package}/share/knurl/RELEASE_MANIFEST" "${manifest}")
find_program(TAR NAMES gtar tar REQUIRED)
find_program(GZIP gzip REQUIRED)
run("${TAR}" --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner
  --mode=u=rwX,go=rX --format=ustar -C "${work}" -cf "${work}/sdk.tar" "${package}")
execute_process(COMMAND "${GZIP}" -n -c "${work}/sdk.tar"
  OUTPUT_FILE "${work}/sdk.tar.gz" RESULT_VARIABLE result ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "SDK compression failed: ${errors}")
endif()
configure_file("${work}/sdk.tar.gz" "${OUTPUT_DIR}/${package}.tar.gz" COPYONLY)
file(SHA256 "${OUTPUT_DIR}/${package}.tar.gz" digest)
# This is an explicit binary rehearsal inventory, not a release upload manifest.
file(WRITE "${OUTPUT_DIR}/${package}-BINARY-CHECKSUMS" "${digest}  ${package}.tar.gz\n")
message(STATUS "SDK binary rehearsal: ${OUTPUT_DIR}/${package}-BINARY-CHECKSUMS")
