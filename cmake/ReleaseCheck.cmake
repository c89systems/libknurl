cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
include("${root}/cmake/Version.cmake")
if(DEFINED ROTMOS_CANDIDATE_VERSION AND NOT ROTMOS_CANDIDATE_VERSION STREQUAL "")
  message(FATAL_ERROR "Release gate forbids candidate version overrides")
endif()
function(git output)
  execute_process(COMMAND git -C "${root}" ${ARGN}
    RESULT_VARIABLE code OUTPUT_VARIABLE value ERROR_VARIABLE error
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Release identity check: ${ARGN}: ${error}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()
git(owner rev-parse --show-toplevel)
if(NOT owner STREQUAL root)
  message(FATAL_ERROR "Release requires the owning checkout")
endif()
git(default symbolic-ref --short refs/remotes/origin/HEAD)
string(REGEX REPLACE "^origin/" "" default "${default}")
git(branch symbolic-ref --short HEAD)
if(NOT branch STREQUAL default)
  message(FATAL_ERROR "Release gate requires default branch ${default}; current: ${branch}")
endif()
git(dirty status --porcelain)
if(NOT dirty STREQUAL "")
  message(FATAL_ERROR "Release gate requires a clean committed worktree")
endif()
git(signature verify-commit HEAD)
rotmos_version("${root}" version)
git(tag rev-parse "refs/tags/v${version}")
git(head rev-parse HEAD)
if(NOT tag STREQUAL head)
  message(FATAL_ERROR "Release requires an exact lightweight vX.Y.Z tag on signed HEAD")
endif()
message(STATUS "Release identity accepted: ${branch} ${head} v${version}")
