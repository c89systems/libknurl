@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(CpktCore 0.6.1 EXACT CONFIG REQUIRED)
find_dependency(Threads REQUIRED)
find_dependency(OpenSSL CONFIG REQUIRED)
find_dependency(CURL CONFIG REQUIRED)
find_dependency(LibXml2 CONFIG REQUIRED)
find_dependency(lonejson 0.47.0 EXACT CONFIG REQUIRED)
find_dependency(pslog 0.13.0 EXACT CONFIG REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/rotmosTargets.cmake")
set(rotmos_static_FOUND FALSE)
set(rotmos_shared_FOUND FALSE)
if(TARGET rotmos::static)
  set(rotmos_static_FOUND TRUE)
endif()
if(TARGET rotmos::shared)
  set(rotmos_shared_FOUND TRUE)
endif()
check_required_components(rotmos)
