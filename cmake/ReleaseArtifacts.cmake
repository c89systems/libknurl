cmake_minimum_required(VERSION 3.24)
# This command is only reachable after the signed, clean release gate. It never
# builds, signs, tags or publishes. Copy the verified bytes, not dist globs.
include("${CMAKE_CURRENT_LIST_DIR}/ReleaseCheck.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/OwnedPaths.cmake")
set(destination "${root}/dist/release-v${version}")
rotmos_require_owned_path("${destination}" "Release artifacts")
if(EXISTS "${destination}")
  message(FATAL_ERROR "Final artifact directory already exists; preserve the frozen release")
endif()
set(manifest "")
function(copy_verified path expected)
  file(SHA256 "${path}" digest)
  if(NOT digest STREQUAL expected)
    message(FATAL_ERROR "Final artifact checksum changed: ${path}")
  endif()
  get_filename_component(name "${path}" NAME)
  configure_file("${path}" "${destination}/${name}" COPYONLY)
  file(SHA256 "${destination}/${name}" copied)
  if(NOT copied STREQUAL digest)
    message(FATAL_ERROR "Final artifact copy changed: ${name}")
  endif()
  set(manifest "${manifest}${digest}  ${name}\n" PARENT_SCOPE)
endfunction()
execute_process(COMMAND "${root}/scripts/lifecycle/cpkt-toolchains.sh" targets
  OUTPUT_VARIABLE targets OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" targets "${targets}")
foreach(target IN LISTS targets)
  set(binary "${root}/build/${target}/release")
  if(target STREQUAL "x86_64-linux-gnu")
    set(binary "${root}/build/release")
  endif()
  set(package "librotmos-${version}-${target}")
  file(READ "${binary}/packages/${package}-BINARY-CHECKSUMS" inventory)
  file(SHA256 "${binary}/packages/${package}.tar.gz" digest)
  if(NOT inventory STREQUAL "${digest}  ${package}.tar.gz\n")
    message(FATAL_ERROR "Final SDK inventory mismatch: ${target}")
  endif()
  copy_verified("${binary}/packages/${package}.tar.gz" "${digest}")
endforeach()
set(products "${root}/build/release/lua/tests/package/products")
set(package "lua-rotmos-${version}")
file(STRINGS "${products}/${package}-CHECKSUMS" inventory)
list(LENGTH inventory count)
if(NOT count EQUAL 3)
  message(FATAL_ERROR "Final Lua inventory must identify all three products")
endif()
foreach(name "${package}.tar.gz" "${package}-1.rockspec" "${package}-1.src.rock")
  file(SHA256 "${products}/${name}" digest)
  list(FIND inventory "${digest}  ${name}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Final Lua product checksum mismatch: ${name}")
  endif()
  copy_verified("${products}/${name}" "${digest}")
endforeach()
file(WRITE "${destination}/CHECKSUMS" "${manifest}")
file(SHA256 "${destination}/CHECKSUMS" manifest_identity)
message(STATUS "Final checksum manifest: ${manifest_identity}  ${destination}/CHECKSUMS")
