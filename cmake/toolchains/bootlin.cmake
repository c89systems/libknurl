cmake_minimum_required(VERSION 3.21)
set(ROTMOS_TARGET "x86_64-linux-gnu" CACHE STRING "Selected SDK/toolchain target")
get_filename_component(rotmos_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(resolver "${rotmos_root}/scripts/lifecycle/cpkt-toolchains.sh")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ROTMOS_TARGET)
execute_process(COMMAND "${resolver}" discover "${ROTMOS_TARGET}"
  RESULT_VARIABLE result OUTPUT_VARIABLE description ERROR_VARIABLE diagnostic)
if(NOT result EQUAL 0 OR NOT description MATCHES "(^|[\r\n])status=ready([\r\n]|$)")
  message(FATAL_ERROR "Prepare the pinned ${ROTMOS_TARGET} toolchain with scripts/lifecycle/cpkt-toolchains.sh ensure ${ROTMOS_TARGET}: ${diagnostic}")
endif()
foreach(key cc cxx ld ar ranlib strip nm objcopy objdump addr2line readelf sysroot root)
  string(REGEX MATCH "(^|[\r\n])${key}=([^\r\n]+)" found "${description}")
  if(NOT found)
    message(FATAL_ERROR "Toolchain discovery did not report ${key}")
  endif()
  set(bootlin_${key} "${CMAKE_MATCH_2}")
endforeach()
set(CMAKE_C_COMPILER "${bootlin_cc}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${bootlin_cxx}" CACHE FILEPATH "" FORCE)
set(CMAKE_LINKER "${bootlin_ld}" CACHE FILEPATH "" FORCE)
foreach(key AR RANLIB STRIP NM OBJCOPY OBJDUMP ADDR2LINE READELF)
  string(TOLOWER "${key}" lower)
  set(CMAKE_${key} "${bootlin_${lower}}" CACHE FILEPATH "" FORCE)
endforeach()
set(CMAKE_SYSROOT "${bootlin_sysroot}" CACHE PATH "" FORCE)
set(CMAKE_FIND_ROOT_PATH "${bootlin_sysroot}" "${bootlin_root}" CACHE STRING "" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_SYSTEM_NAME Linux)
if(ROTMOS_TARGET MATCHES "^x86_64-")
  set(CMAKE_SYSTEM_PROCESSOR x86_64)
elseif(ROTMOS_TARGET MATCHES "^aarch64-")
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
else()
  set(CMAKE_SYSTEM_PROCESSOR arm)
endif()
