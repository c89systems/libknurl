cmake_minimum_required(VERSION 3.24)
set(ROTMOS_TARGET "x86_64-linux-gnu" CACHE STRING "Concrete lifecycle architecture/OS target")
get_filename_component(rotmos_toolchain_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(rotmos_resolver "${rotmos_toolchain_root}/scripts/lifecycle/cpkt-toolchains.sh")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ROTMOS_TARGET CPKT_OSXCROSS_HOST ROTMOS_AFL)

if(ROTMOS_TARGET STREQUAL "arm64-apple-darwin" AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
  set(CMAKE_SYSTEM_NAME Darwin)
  set(CMAKE_SYSTEM_PROCESSOR arm64)
  foreach(key cc cxx ld ar ranlib strip nm otool)
    if(key STREQUAL "cc")
      set(tool clang)
    elseif(key STREQUAL "cxx")
      set(tool clang++)
    else()
      set(tool "${key}")
    endif()
    execute_process(COMMAND xcrun --sdk macosx --find "${tool}"
      RESULT_VARIABLE result OUTPUT_VARIABLE selected_${key} OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0 OR NOT EXISTS "${selected_${key}}")
      message(FATAL_ERROR "Selected Apple tool is unavailable: ${tool}")
    endif()
  endforeach()
  execute_process(COMMAND xcrun --sdk macosx --show-sdk-path
    RESULT_VARIABLE result OUTPUT_VARIABLE selected_sysroot OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT result EQUAL 0 OR NOT IS_DIRECTORY "${selected_sysroot}")
    message(FATAL_ERROR "Selected Apple macOS SDK is unavailable")
  endif()
  set(selected_root "${selected_sysroot}")
else()
  execute_process(COMMAND "${rotmos_resolver}" discover "${ROTMOS_TARGET}"
    RESULT_VARIABLE result OUTPUT_VARIABLE description ERROR_VARIABLE diagnostic)
  if(NOT result EQUAL 0 OR NOT description MATCHES "(^|[\r\n])status=ready([\r\n]|$)")
    message(FATAL_ERROR "Prepare the selected ${ROTMOS_TARGET} toolchain with make toolchain TARGET=${ROTMOS_TARGET}: ${diagnostic}${description}")
  endif()
  foreach(key cc cxx ld ar ranlib strip nm root)
    string(REGEX MATCH "(^|[\r\n])${key}=([^\r\n]+)" found "${description}")
    if(NOT found)
      message(FATAL_ERROR "Selected toolchain did not report ${key}")
    endif()
    set(selected_${key} "${CMAKE_MATCH_2}")
  endforeach()
  if(ROTMOS_TARGET STREQUAL "arm64-apple-darwin")
    set(CMAKE_SYSTEM_NAME Darwin)
    set(CMAKE_SYSTEM_PROCESSOR arm64)
    string(REGEX MATCH "(^|[\r\n])otool=([^\r\n]+)" found "${description}")
    set(selected_otool "${CMAKE_MATCH_2}")
    file(GLOB selected_sdks LIST_DIRECTORIES TRUE "${selected_root}/SDK/MacOSX*.sdk")
    list(SORT selected_sdks COMPARE NATURAL ORDER DESCENDING)
    if(NOT selected_sdks)
      message(FATAL_ERROR "The selected osxcross collection contains no macOS SDK")
    endif()
    list(GET selected_sdks 0 selected_sysroot)
    foreach(kind EXE SHARED MODULE)
      set(CMAKE_${kind}_LINKER_FLAGS_INIT "--ld-path=\"${selected_ld}\"")
    endforeach()
  else()
    set(CMAKE_SYSTEM_NAME Linux)
    if(ROTMOS_TARGET MATCHES "^x86_64-linux-(gnu|musl)$")
      set(CMAKE_SYSTEM_PROCESSOR x86_64)
    elseif(ROTMOS_TARGET MATCHES "^aarch64-linux-(gnu|musl)$")
      set(CMAKE_SYSTEM_PROCESSOR aarch64)
    elseif(ROTMOS_TARGET MATCHES "^armhf-linux-(gnu|musl)$")
      set(CMAKE_SYSTEM_PROCESSOR arm)
    else()
      message(FATAL_ERROR "Unsupported concrete target: ${ROTMOS_TARGET}")
    endif()
    foreach(key objcopy objdump addr2line readelf sysroot)
      string(REGEX MATCH "(^|[\r\n])${key}=([^\r\n]+)" found "${description}")
      if(NOT found)
        message(FATAL_ERROR "Selected Bootlin collection did not report ${key}")
      endif()
      set(selected_${key} "${CMAKE_MATCH_2}")
    endforeach()
    foreach(key OBJCOPY OBJDUMP ADDR2LINE READELF)
      string(TOLOWER "${key}" lower)
      set(CMAKE_${key} "${selected_${lower}}" CACHE FILEPATH "" FORCE)
    endforeach()
    set(CMAKE_SYSROOT "${selected_sysroot}" CACHE PATH "" FORCE)
  endif()
endif()

set(CMAKE_C_COMPILER "${selected_cc}" CACHE FILEPATH "" FORCE)
if(ROTMOS_AFL)
  if(NOT ROTMOS_TARGET STREQUAL "x86_64-linux-gnu" OR
      NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR
      NOT CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    message(FATAL_ERROR "AFL++ requires native x86_64 Linux and the selected GNU collection")
  endif()
  execute_process(COMMAND "${rotmos_toolchain_root}/scripts/lifecycle/cpkt-aflpp.sh" discover
    RESULT_VARIABLE code OUTPUT_VARIABLE afl ERROR_VARIABLE error)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Prepare pinned AFL++ with make fuzz-toolchain: ${error}")
  endif()
  foreach(key cc cxx)
    string(REGEX MATCH "(^|[\r\n])${key}=([^\r\n]+)" found "${afl}")
    if(NOT found)
      message(FATAL_ERROR "AFL++ resolver omitted ${key}")
    endif()
    set(selected_${key} "${CMAKE_MATCH_2}")
  endforeach()
  set(CMAKE_C_COMPILER "${selected_cc}" CACHE FILEPATH "" FORCE)
endif()
set(CMAKE_CXX_COMPILER "${selected_cxx}" CACHE FILEPATH "" FORCE)
set(CMAKE_LINKER "${selected_ld}" CACHE FILEPATH "" FORCE)
foreach(key AR RANLIB STRIP NM)
  string(TOLOWER "${key}" lower)
  set(CMAKE_${key} "${selected_${lower}}" CACHE FILEPATH "" FORCE)
endforeach()
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
  set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "" FORCE)
  set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0" CACHE STRING "" FORCE)
  set(CMAKE_OSX_SYSROOT "${selected_sysroot}" CACHE PATH "" FORCE)
  set(CMAKE_OTOOL "${selected_otool}" CACHE FILEPATH "" FORCE)
endif()
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH "${selected_sysroot}" "${selected_root}" CACHE STRING "" FORCE)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
