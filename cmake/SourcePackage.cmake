cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
include("${root}/cmake/OwnedPaths.cmake")
include("${root}/cmake/Version.cmake")
include("${root}/cmake/Privacy.cmake")
include("${root}/cmake/PublicDocs.cmake")
find_program(GIT git REQUIRED)
find_program(TAR NAMES gtar tar REQUIRED)
find_program(GZIP gzip REQUIRED)
execute_process(COMMAND "${GIT}" -C "${root}" rev-parse --show-toplevel
  OUTPUT_VARIABLE owner OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT owner STREQUAL root)
  message(FATAL_ERROR "Source packaging requires the owning Git checkout")
endif()
knurl_version("${root}" version)
set(package "libknurl-${version}")
set(output "${root}/build/source-package")
knurl_require_owned_path("${output}" "Source package")
set(work "${output}/stage")
set(stage "${work}/${package}")
set(extracted "${output}/extracted")
knurl_require_owned_path("${work}" "Source stage")
knurl_require_owned_path("${extracted}" "Extracted source")
file(REMOVE_RECURSE "${work}" "${extracted}")
file(MAKE_DIRECTORY "${stage}" "${extracted}")

# Only tracked reconstruction inputs enter the source archive. The historical
# archive, hosted workflow and every generated checkout directory stay out.
execute_process(COMMAND "${GIT}" -C "${root}" ls-files --
  .clang-format .clangd .gitattributes .gitignore CMakeLists.txt CMakePresets.json
  KORE.md LICENSE LICENSES Makefile README.md binary cmake docs examples include
  lua patches scripts src tests vendor
  OUTPUT_VARIABLE files OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "\n" ";" files "${files}")
foreach(required CMakeLists.txt docs/knurl.md cmake/EmbedLua.cmake vendor/kore.revision)
  if(NOT required IN_LIST files)
    message(FATAL_ERROR "Missing tracked source package input: ${required}")
  endif()
endforeach()
foreach(path IN LISTS files)
  if(IS_SYMLINK "${root}/${path}" OR NOT EXISTS "${root}/${path}" OR
      NOT path MATCHES "^[a-zA-Z0-9_./+-]+$" OR path MATCHES "(^|/)[.][.](/|$)")
    message(FATAL_ERROR "Unexpected source package input: ${path}")
  endif()
  get_filename_component(directory "${path}" DIRECTORY)
  file(COPY "${root}/${path}" DESTINATION "${stage}/${directory}")
endforeach()
file(WRITE "${stage}/VERSION" "${version}\n")
list(APPEND files VERSION)
list(SORT files)
set(manifest "")
foreach(path IN LISTS files)
  file(SHA256 "${stage}/${path}" digest)
  string(APPEND manifest "${digest}  ${path}\n")
endforeach()
file(WRITE "${stage}/RELEASE_MANIFEST" "${manifest}")
execute_process(COMMAND "${TAR}" --sort=name --mtime=@0 --owner=0 --group=0
  --numeric-owner --mode=u+rw,go+r,go-w,a+X --format=ustar -C "${work}"
  -cf "${work}/source.tar" "${package}" COMMAND_ERROR_IS_FATAL ANY)
set(archive "${work}/source.tar.gz")
execute_process(COMMAND "${GZIP}" -n -c "${work}/source.tar"
  OUTPUT_FILE "${archive}" COMMAND_ERROR_IS_FATAL ANY)
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extracted}")
set(prefix "${extracted}/${package}")
file(GLOB_RECURSE actual LIST_DIRECTORIES FALSE RELATIVE "${prefix}" "${prefix}/*")
set(expected ${files} RELEASE_MANIFEST)
list(SORT expected)
list(SORT actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Extracted source inventory differs from the declared inputs")
endif()
foreach(path IN LISTS expected)
  file(SHA256 "${stage}/${path}" staged_digest)
  file(SHA256 "${prefix}/${path}" extracted_digest)
  if(IS_SYMLINK "${prefix}/${path}" OR NOT staged_digest STREQUAL extracted_digest)
    message(FATAL_ERROR "Extracted source bytes differ: ${path}")
  endif()
  knurl_verify_private_bytes("${prefix}/${path}" SOURCE)
endforeach()
knurl_verify_public_docs("${root}" "${prefix}")
set(KNURL_CANDIDATE_VERSION "")
knurl_version("${prefix}" extracted_version)
if(NOT version STREQUAL extracted_version)
  message(FATAL_ERROR "Extracted source version does not match the package")
endif()
configure_file("${archive}" "${output}/${package}.tar.gz" COPYONLY)
file(SHA256 "${output}/${package}.tar.gz" digest)
file(WRITE "${output}/${package}-SOURCE-CHECKSUMS" "${digest}  ${package}.tar.gz\n")
message(STATUS "Verified source archive: ${output}/${package}.tar.gz")
