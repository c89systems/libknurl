set(KNURL_SDK_ROOT "${CMAKE_SOURCE_DIR}/.cache/sdk/${KNURL_TARGET}" CACHE PATH "Independent released SDK prefixes")
knurl_require_owned_path("${KNURL_SDK_ROOT}" "Dependency SDK directory")
if(NOT EXISTS "${KNURL_SDK_ROOT}/manifest.txt")
  message(FATAL_ERROR "Prepare released SDKs first: scripts/deps.sh ${KNURL_TARGET}")
endif()
file(READ "${KNURL_SDK_ROOT}/manifest.txt" dependency_manifest)
if(NOT dependency_manifest MATCHES "(^|\n)target=${KNURL_TARGET}(\n|$)")
  message(FATAL_ERROR "SDK target does not match ${KNURL_TARGET}")
endif()
foreach(name cpkt lonejson pslog)
  knurl_require_owned_path("${KNURL_SDK_ROOT}/${name}" "${name} SDK prefix")
  if(NOT IS_DIRECTORY "${KNURL_SDK_ROOT}/${name}")
    message(FATAL_ERROR "Missing ${name} SDK; run scripts/deps.sh ${KNURL_TARGET}")
  endif()
  list(APPEND CMAKE_PREFIX_PATH "${KNURL_SDK_ROOT}/${name}")
  list(APPEND CMAKE_FIND_ROOT_PATH "${KNURL_SDK_ROOT}/${name}")
endforeach()
find_package(CpktCore 0.7.0 EXACT CONFIG REQUIRED)
if(NOT CpktCore_TARGET_ID STREQUAL KNURL_TARGET)
  message(FATAL_ERROR "The cpkt SDK has the wrong target identity")
endif()
find_package(Threads REQUIRED)
find_package(OpenSSL CONFIG REQUIRED)
find_package(CURL CONFIG REQUIRED)
find_package(ZLIB 1.3.2 EXACT CONFIG REQUIRED)
find_package(LibXml2 CONFIG REQUIRED)
find_package(lonejson 0.50.0 EXACT CONFIG REQUIRED)
find_package(pslog 0.13.0 EXACT CONFIG REQUIRED)
