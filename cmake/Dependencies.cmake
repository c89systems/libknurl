set(ROTMOS_SDK_ROOT "${CMAKE_SOURCE_DIR}/.cache/sdk/${ROTMOS_TARGET}" CACHE PATH "Independent released SDK prefixes")
rotmos_require_owned_path("${ROTMOS_SDK_ROOT}" "Dependency SDK directory")
if(NOT EXISTS "${ROTMOS_SDK_ROOT}/manifest.txt")
  message(FATAL_ERROR "Prepare released SDKs first: scripts/deps.sh ${ROTMOS_TARGET}")
endif()
file(READ "${ROTMOS_SDK_ROOT}/manifest.txt" dependency_manifest)
if(NOT dependency_manifest MATCHES "(^|\n)target=${ROTMOS_TARGET}(\n|$)")
  message(FATAL_ERROR "SDK target does not match ${ROTMOS_TARGET}")
endif()
foreach(name cpkt lonejson pslog)
  if(NOT IS_DIRECTORY "${ROTMOS_SDK_ROOT}/${name}")
    message(FATAL_ERROR "Missing ${name} SDK; run scripts/deps.sh ${ROTMOS_TARGET}")
  endif()
  list(APPEND CMAKE_PREFIX_PATH "${ROTMOS_SDK_ROOT}/${name}")
  list(APPEND CMAKE_FIND_ROOT_PATH "${ROTMOS_SDK_ROOT}/${name}")
endforeach()
find_package(CpktCore 0.6.1 EXACT CONFIG REQUIRED)
if(NOT CpktCore_TARGET_ID STREQUAL ROTMOS_TARGET)
  message(FATAL_ERROR "The cpkt SDK has the wrong target identity")
endif()
find_package(Threads REQUIRED)
find_package(OpenSSL CONFIG REQUIRED)
find_package(CURL CONFIG REQUIRED)
find_package(LibXml2 CONFIG REQUIRED)
find_package(lonejson 0.46.0 EXACT CONFIG REQUIRED)
find_package(pslog 0.13.0 EXACT CONFIG REQUIRED)
