cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
include("${root}/cmake/OwnedPaths.cmake")
include("${root}/cmake/Privacy.cmake")
include("${root}/cmake/PublicDocs.cmake")
set(sdk_docs ${knurl_public_docs})
list(TRANSFORM sdk_docs PREPEND "share/knurl/")
knurl_require_owned_path("${BUILD_DIR}" "SDK verification build")
include("${BUILD_DIR}/sdk-build.cmake")
if(NOT SDK_ROOT STREQUAL root OR NOT SDK_BINARY STREQUAL BUILD_DIR)
  message(FATAL_ERROR "SDK description belongs to another checkout/build")
endif()
if(NOT OUTPUT_DIR)
  set(OUTPUT_DIR "${BUILD_DIR}/packages")
endif()
knurl_require_owned_path("${OUTPUT_DIR}" "SDK verification input")
set(package "libknurl-${SDK_VERSION}-${SDK_TARGET}")
set(archive "${OUTPUT_DIR}/${package}.tar.gz")
set(work "${BUILD_DIR}/package-verification")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "SDK verification command failed: ${ARGV}\n${output}${errors}")
  endif()
  set(command_output "${output}" PARENT_SCOPE)
endfunction()
file(READ "${OUTPUT_DIR}/${package}-BINARY-CHECKSUMS" checksums)
file(SHA256 "${archive}" archive_sha)
if(NOT checksums STREQUAL "${archive_sha}  ${package}.tar.gz\n")
  message(FATAL_ERROR "SDK binary checksum inventory does not match")
endif()
run("${CMAKE_COMMAND}" -E tar tf "${archive}")
string(REPLACE "\n" ";" entries "${command_output}")
foreach(entry IN LISTS entries)
  if(entry STREQUAL "")
    continue()
  endif()
  if(NOT entry MATCHES "^${package}/" OR entry MATCHES "(^|/)[.][.](/|$)")
    message(FATAL_ERROR "Unexpected SDK archive entry: ${entry}")
  endif()
endforeach()
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${work}")
# Consume the actual final bytes at a different prefix, including a space.
file(RENAME "${work}/${package}" "${work}/relocated SDK")
set(prefix "${work}/relocated SDK")
file(STRINGS "${prefix}/share/knurl/RELEASE_MANIFEST" records)
set(expected share/knurl/RELEASE_MANIFEST)
foreach(record IN LISTS records)
  if(NOT record MATCHES "^([a-f0-9]+)  ([^;]+)$")
    message(FATAL_ERROR "Invalid SDK file manifest record: ${record}")
  endif()
  set(digest "${CMAKE_MATCH_1}")
  set(path "${CMAKE_MATCH_2}")
  string(LENGTH "${digest}" length)
  if(NOT length EQUAL 64 OR IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)[.][.](/|$)" OR
      (NOT path IN_LIST sdk_docs AND
       NOT path MATCHES "^(include/knurl/[a-z_]+[.]h|lib/(libknurl[^/]+|cmake/knurl/[^/]+[.]cmake|pkgconfig/knurl[.]pc)|share/(licenses/knurl/(kore/)?[^/]+|knurl/(SDK|DEPENDENCIES|BACKEND|examples/(README[.]md|server[.]c|CMakeLists[.]txt))))$"))
    message(FATAL_ERROR "Unexpected SDK payload: ${path}")
  endif()
  list(APPEND expected "${path}")
  if(IS_SYMLINK "${prefix}/${path}")
    file(READ_SYMLINK "${prefix}/${path}" link)
    if(IS_ABSOLUTE "${link}" OR link MATCHES "(^|/)[.][.](/|$)" OR NOT EXISTS "${prefix}/${path}")
      message(FATAL_ERROR "Invalid SDK symlink: ${path} -> ${link}")
    endif()
    string(SHA256 actual "symlink:${link}")
  else()
    file(SHA256 "${prefix}/${path}" actual)
  endif()
  if(NOT digest STREQUAL actual)
    message(FATAL_ERROR "SDK payload digest mismatch: ${path}")
  endif()
endforeach()
file(GLOB_RECURSE actual LIST_DIRECTORIES FALSE RELATIVE "${prefix}" "${prefix}/*")
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "SDK final inventory mismatch")
endif()
foreach(required include/knurl/knurl.h include/knurl/kore.h lib/libknurl.a
    lib/pkgconfig/knurl.pc lib/cmake/knurl/knurlConfig.cmake
    share/licenses/knurl/LICENSE share/licenses/knurl/kore/LICENSE
    share/licenses/knurl/BSD-queue.txt share/knurl/DEPENDENCIES share/knurl/BACKEND
    share/knurl/examples/README.md)
  if(NOT EXISTS "${prefix}/${required}")
    message(FATAL_ERROR "Missing SDK payload: ${required}")
  endif()
endforeach()
foreach(private executor.h framing.h)
  if(EXISTS "${prefix}/include/knurl/${private}")
    message(FATAL_ERROR "Private SDK header: ${private}")
  endif()
endforeach()
file(READ "${prefix}/share/knurl/SDK" identity)
file(READ "${BUILD_DIR}/SDK" configured_identity)
if(NOT identity STREQUAL configured_identity)
  message(FATAL_ERROR "Incorrect SDK identity")
endif()
foreach(license LICENSE vendor/kore/LICENSE LICENSES/BSD-queue.txt)
  if(license STREQUAL "vendor/kore/LICENSE")
    set(installed_license kore/LICENSE)
  else()
    get_filename_component(installed_license "${license}" NAME)
  endif()
  file(SHA256 "${root}/${license}" source_digest)
  file(SHA256 "${prefix}/share/licenses/knurl/${installed_license}" installed_digest)
  if(NOT source_digest STREQUAL installed_digest)
    message(FATAL_ERROR "SDK license bytes do not match: ${license}")
  endif()
endforeach()
foreach(metadata DEPENDENCIES BACKEND)
  file(READ "${prefix}/share/knurl/${metadata}" actual)
  file(READ "${BUILD_DIR}/${metadata}" configured)
  if(NOT actual STREQUAL configured)
    message(FATAL_ERROR "SDK ${metadata} does not match configured inputs")
  endif()
endforeach()
foreach(path IN LISTS expected)
  if(IS_SYMLINK "${prefix}/${path}")
    continue()
  endif()
  knurl_verify_private_bytes("${prefix}/${path}")
endforeach()
knurl_verify_archive_metadata("${prefix}/lib/libknurl.a" "${SDK_AR}")
knurl_verify_public_docs("${root}" "${prefix}/share/knurl")
if(SDK_PLATFORM STREQUAL "Darwin")
  set(shared "${prefix}/lib/libknurl.${SDK_VERSION}.dylib")
  run("${SDK_OTOOL}" -hv "${shared}" "${prefix}/lib/libknurl.a")
  if(NOT command_output MATCHES "ARM64" OR command_output MATCHES "X86_64|I386")
    message(FATAL_ERROR "SDK Mach-O architecture mismatch")
  endif()
  run("${SDK_OTOOL}" -L "${shared}")
  if(NOT command_output MATCHES "@rpath/libknurl[.]${SDK_ABI}[.]dylib")
    message(FATAL_ERROR "SDK dylib ABI identity mismatch: ${command_output}")
  endif()
  string(REPLACE "\n" ";" imports "${command_output}")
  list(REMOVE_AT imports 0)
  foreach(import IN LISTS imports)
    if(import MATCHES "^[ \t]+([^ \t]+)")
      set(name "${CMAKE_MATCH_1}")
      if(NOT name MATCHES "^(@rpath/|/usr/lib/|/System/Library/)")
        message(FATAL_ERROR "Nonrelocatable Mach-O import: ${name}")
      endif()
    endif()
  endforeach()
else()
  set(shared "${prefix}/lib/libknurl.so.${SDK_VERSION}")
  if(SDK_ARCH STREQUAL "x86_64")
    set(machine "Advanced Micro Devices X86-64")
  elseif(SDK_ARCH STREQUAL "aarch64")
    set(machine "AArch64")
  else()
    set(machine "ARM")
  endif()
  run("${SDK_READELF}" -h "${shared}" "${prefix}/lib/libknurl.a")
  string(REGEX MATCHALL "Machine:[^\n]+" machines "${command_output}")
  foreach(line IN LISTS machines)
    string(STRIP "${line}" line)
    if(NOT line MATCHES "Machine:[ \t]+${machine}$")
      message(FATAL_ERROR "SDK ELF architecture mismatch: ${line}")
    endif()
  endforeach()
  if(NOT machines)
    message(FATAL_ERROR "No SDK ELF headers inspected")
  endif()
  run("${SDK_READELF}" -d "${shared}")
  if(NOT command_output MATCHES "SONAME[^\n]+\\[libknurl[.]so[.]${SDK_ABI}\\]")
    message(FATAL_ERROR "SDK ELF ABI identity mismatch")
  endif()
  if(command_output MATCHES "NEEDED[^\n]+\\[[^]]*/[^]]*\\]")
    message(FATAL_ERROR "Absolute/path-qualified ELF dependency")
  endif()
  string(REGEX MATCHALL "(RPATH|RUNPATH)[^\n]+" paths "${command_output}")
  foreach(path IN LISTS paths)
    string(REGEX MATCH "\\[([^]]*)\\]" found "${path}")
    string(REPLACE ":" ";" directories "${CMAKE_MATCH_1}")
    foreach(directory IN LISTS directories)
      if(NOT directory MATCHES "^\\$ORIGIN(/|$)")
        message(FATAL_ERROR "Nonrelocatable ELF runtime path: ${directory}")
      endif()
    endforeach()
  endforeach()
endif()
run("${CMAKE_COMMAND}" "-DNM=${SDK_NM}" "-DLIBRARY=${shared}" "-DPLATFORM=${SDK_PLATFORM}"
  -P "${root}/tests/PublicBoundary.cmake")
set(pc_path "${prefix}/lib/pkgconfig:${SDK_PROVIDERS}/cpkt/lib/pkgconfig:${SDK_PROVIDERS}/lonejson/lib/pkgconfig:${SDK_PROVIDERS}/pslog/lib/pkgconfig")
foreach(discovery cmake pkgconfig)
  foreach(variant static shared)
    set(consumer "${work}/${discovery}-${variant}")
    run("${CMAKE_COMMAND}" -E env "PKG_CONFIG_PATH=${pc_path}" "PKG_CONFIG_LIBDIR=${pc_path}"
      "${CMAKE_COMMAND}" -S "${prefix}/share/knurl/examples" -B "${consumer}" -G Ninja
      "-DCMAKE_TOOLCHAIN_FILE=${SDK_TOOLCHAIN}" "-DKNURL_TARGET=${SDK_TARGET}"
      "-DCMAKE_BUILD_TYPE=${SDK_CONFIGURATION}"
      "-DCMAKE_PROJECT_INCLUDE=${root}/cmake/DebugTestStacks.cmake"
      "-DKNURL_PREFIX=${prefix}" "-DKNURL_SDK_ROOT=${SDK_PROVIDERS}"
      "-DKNURL_VARIANT=${variant}" "-DKNURL_DISCOVERY=${discovery}"
      "-DKNURL_VERSION=${SDK_VERSION}"
      "-DKNURL_VERIFY_RUN=${SDK_CAN_RUN}")
    run("${CMAKE_COMMAND}" --build "${consumer}" --parallel 1)
    if(SDK_CAN_RUN)
      run("${consumer}/server" --check)
    endif()
  endforeach()
endforeach()
message(STATUS "Verified final SDK bytes and four relocated consumers: ${SDK_TARGET}")
