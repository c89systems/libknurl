cmake_minimum_required(VERSION 3.24)

# Both products declare the repository root; never adopt an enclosing checkout.
function(knurl_version root output)
  file(REAL_PATH "${root}" root)
  find_program(knurl_git git)
  set(owner "")
  if(knurl_git)
    execute_process(COMMAND "${knurl_git}" -C "${root}" rev-parse --show-toplevel
      OUTPUT_VARIABLE owner OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(owner)
      file(REAL_PATH "${owner}" owner)
    endif()
  endif()
  if(owner STREQUAL root)
    set(version "0.0.0")
    execute_process(COMMAND "${knurl_git}" -C "${root}" tag --points-at HEAD
      OUTPUT_VARIABLE tags OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\n" ";" tags "${tags}")
    set(release_tags)
    foreach(tag IN LISTS tags)
      if(tag MATCHES "^v[0-9]+[.][0-9]+[.][0-9]+$")
        execute_process(COMMAND "${knurl_git}" -C "${root}" symbolic-ref -q "refs/tags/${tag}"
          RESULT_VARIABLE symbolic OUTPUT_QUIET ERROR_QUIET)
        if(symbolic EQUAL 0)
          message(FATAL_ERROR "Release tag ${tag} must not be symbolic")
        endif()
        execute_process(COMMAND "${knurl_git}" -C "${root}" cat-file -t "refs/tags/${tag}"
          OUTPUT_VARIABLE kind OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        if(NOT kind STREQUAL "commit")
          message(FATAL_ERROR "Release tag ${tag} must be lightweight")
        endif()
        list(APPEND release_tags "${tag}")
      endif()
    endforeach()
    list(LENGTH release_tags count)
    if(count GREATER 1)
      message(FATAL_ERROR "Ambiguous exact release tags: ${release_tags}")
    elseif(count EQUAL 1)
      string(SUBSTRING "${release_tags}" 1 -1 version)
    endif()
    if(DEFINED KNURL_CANDIDATE_VERSION AND NOT KNURL_CANDIDATE_VERSION STREQUAL "")
      set(version "${KNURL_CANDIDATE_VERSION}")
    endif()
    # Reconfigure after commits/tag changes, without recompiling unchanged bytes.
    if(NOT CMAKE_SCRIPT_MODE_FILE)
      foreach(ref HEAD packed-refs refs/tags refs/heads)
        execute_process(COMMAND "${knurl_git}" -C "${root}" rev-parse --path-format=absolute --git-path "${ref}"
          OUTPUT_VARIABLE path OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        if(IS_DIRECTORY "${path}")
          file(GLOB_RECURSE refs CONFIGURE_DEPENDS "${path}/*")
        else()
          file(GLOB refs CONFIGURE_DEPENDS "${path}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${refs})
      endforeach()
    endif()
  else()
    if(NOT EXISTS "${root}/VERSION" OR NOT EXISTS "${root}/RELEASE_MANIFEST")
      message(FATAL_ERROR "Extracted sources require injected VERSION and RELEASE_MANIFEST")
    endif()
    file(SHA256 "${root}/VERSION" digest)
    file(STRINGS "${root}/RELEASE_MANIFEST" entry REGEX "^[0-9a-f]+  VERSION$")
    if(NOT entry STREQUAL "${digest}  VERSION")
      message(FATAL_ERROR "Injected VERSION does not match RELEASE_MANIFEST")
    endif()
    file(STRINGS "${root}/VERSION" version LIMIT_COUNT 1)
    if(DEFINED KNURL_CANDIDATE_VERSION AND NOT KNURL_CANDIDATE_VERSION STREQUAL "")
      message(FATAL_ERROR "Extracted source version cannot be overridden")
    endif()
  endif()
  if(NOT version MATCHES "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$")
    message(FATAL_ERROR "Invalid release/candidate version: ${version}")
  endif()
  set(${output} "${version}" PARENT_SCOPE)
endfunction()
