prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: librotmos
Description: C89 HTTP server library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lrotmos
Cflags: -I${includedir}
Requires: pslog = 0.13.0
Requires.private: libcurl openssl lonejson = 0.45.0
