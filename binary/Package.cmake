cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
include("${root}/cmake/OwnedPaths.cmake")
include("${root}/cmake/Privacy.cmake")
knurl_require_owned_path("${BUILD_DIR}" "Runner build")
include("${BUILD_DIR}/sdk-build.cmake")
file(STRINGS "${root}/cmake/RunnerTargets.txt" targets)
if(NOT SDK_ROOT STREQUAL root OR NOT SDK_BINARY STREQUAL BUILD_DIR OR NOT SDK_TARGET IN_LIST targets)
  message(FATAL_ERROR "Select an owned knurl runner build on one of ${targets}")
endif()
include("${BUILD_DIR}/runner-build.cmake")
set(package "knurl-${SDK_VERSION}-${SDK_TARGET}")
set(work "${BUILD_DIR}/runner-stage")
set(output "${BUILD_DIR}/packages")
set(prefix "${work}/${package}")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${prefix}" "${output}")

function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Runner package command failed: ${ARGV}\n${log}${errors}")
  endif()
  set(command_output "${log}" PARENT_SCOPE)
endfunction()

run("${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${prefix}" --component binary)
if(SDK_PLATFORM STREQUAL "Linux")
  run("${SDK_STRIP}" --strip-all "${prefix}/${RUNNER_BINDIR}/knurl")
endif()
file(GLOB_RECURSE staged LIST_DIRECTORIES FALSE RELATIVE "${prefix}" "${prefix}/*")
set(files "${RUNNER_BINDIR}/knurl")
set(notices "${RUNNER_DATADIR}/licenses/knurl")
list(APPEND files "${notices}/LICENSE" "${notices}/BSD-queue.txt")
foreach(provider kore curl libxml2 libssh2 nghttp2 openssl zlib lua pslog pslog-lua lonejson lonejson-lua)
  list(APPEND files "${notices}/${provider}/LICENSE")
endforeach()
if(SDK_PLATFORM STREQUAL "Linux")
  list(APPEND files "${notices}/musl.txt")
endif()
list(SORT files)
list(SORT staged)
if(NOT staged STREQUAL files)
  message(FATAL_ERROR "Unexpected runner install payload: ${staged}")
endif()
find_program(TAR NAMES gtar tar REQUIRED)
find_program(GZIP gzip REQUIRED)
run("${TAR}" --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner
  --mode=u=rwX,go=rX --format=ustar -C "${work}" -cf "${work}/runner.tar" "${package}")
execute_process(COMMAND "${GZIP}" -n -c "${work}/runner.tar"
  OUTPUT_FILE "${work}/runner.tar.gz" COMMAND_ERROR_IS_FATAL ANY)

file(MAKE_DIRECTORY "${work}/relocated runner")
file(ARCHIVE_EXTRACT INPUT "${work}/runner.tar.gz" DESTINATION "${work}/relocated runner")
set(relocated "${work}/relocated runner/${package}")
foreach(path IN LISTS files)
  if(IS_SYMLINK "${relocated}/${path}")
    message(FATAL_ERROR "Unexpected runner payload symlink: ${path}")
  endif()
  file(SHA256 "${prefix}/${path}" expected)
  file(SHA256 "${relocated}/${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Packaged runner bytes changed: ${path}")
  endif()
  knurl_verify_private_bytes("${relocated}/${path}")
endforeach()
set(program "${relocated}/${RUNNER_BINDIR}/knurl")
if(SDK_PLATFORM STREQUAL "Linux")
  run("${SDK_READELF}" -hW -lW -dW "${program}")
  if(command_output MATCHES "INTERP|NEEDED|RPATH|RUNPATH|DYNAMIC" OR
      NOT command_output MATCHES "Type:[ \t]+EXEC" OR
      (SDK_ARCH STREQUAL "x86_64" AND NOT command_output MATCHES "Advanced Micro Devices X86-64") OR
      (SDK_ARCH STREQUAL "aarch64" AND NOT command_output MATCHES "AArch64"))
    message(FATAL_ERROR "Runner must be a static ELF executable for ${SDK_ARCH}\n${command_output}")
  endif()
  if(NOT SDK_CAN_RUN)
    find_program(emulator qemu-aarch64 REQUIRED)
  endif()
else()
  run("${SDK_OTOOL}" -hv "${program}")
  if(NOT command_output MATCHES "ARM64[^\n]+EXECUTE")
    message(FATAL_ERROR "Runner must be an arm64 Mach-O executable\n${command_output}")
  endif()
  run("${SDK_OTOOL}" -l "${program}")
  if(command_output MATCHES "LC_RPATH" OR NOT command_output MATCHES "minos 15[.]0" OR
      NOT command_output MATCHES "LC_LOAD_DYLIB[^\n]*\n[^\n]*\n[ \t]*name /usr/lib/libSystem[.]")
    message(FATAL_ERROR "Unexpected runner deployment or loader metadata\n${command_output}")
  endif()
  string(REGEX MATCHALL "LC_(LOAD|LOAD_WEAK|REEXPORT|LOAD_UPWARD|LAZY_LOAD)_DYLIB[^\n]*\n[^\n]*\n[ \t]*name [^\n]*" dylibs "${command_output}")
  foreach(dylib IN LISTS dylibs)
    if(NOT dylib MATCHES "name (/usr/lib/|/System/Library/Frameworks/)")
      message(FATAL_ERROR "Non-system dylib in the runner: ${dylib}")
    endif()
  endforeach()
endif()
if(SDK_CAN_RUN OR emulator)
  run(${emulator} "${program}" --version)
  if(NOT command_output STREQUAL "knurl ${SDK_VERSION}\n")
    message(FATAL_ERROR "Packaged runner version mismatch: ${command_output}")
  endif()
  run("${CMAKE_COMMAND}" "-DHOST=${BUILD_DIR}/knurl_binary_test" "-DBINARY=${program}"
    "-DSCRIPT=${root}/tests/lua/binary.lua" "-DWORK=${work}/runtime" "-DMODE=normal"
    "-DMMDB_FIXTURES=${BUILD_DIR}/tests/mmdb-fixtures"
    "-DEMULATOR=${emulator}" -P "${root}/tests/lua/RunBinary.cmake")
else()
  message(STATUS "Verified Mach-O metadata. Runtime smoke requires an Apple Silicon host.")
endif()

configure_file("${work}/runner.tar.gz" "${output}/${package}.tar.gz" COPYONLY)
file(SHA256 "${output}/${package}.tar.gz" digest)
file(WRITE "${output}/${package}-BINARY-CHECKSUMS" "${digest}  ${package}.tar.gz\n")
message(STATUS "Verified runner tarball: ${output}/${package}.tar.gz")
