include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/OwnedPaths.cmake")
knurl_require_owned_path("${WORK}" "Runner fixture")
file(MAKE_DIRECTORY "${WORK}")
file(REMOVE "${WORK}/server.log")
function(check_help usage)
  foreach(flag --help -h)
    execute_process(COMMAND ${EMULATOR} "${BINARY}" ${ARGN} "${flag}"
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status STREQUAL "0" OR NOT errors STREQUAL "" OR NOT output MATCHES "^Usage: ${usage}")
      message(FATAL_ERROR "Unexpected help result (${ARGN} ${flag}, ${status})\n${output}${errors}")
    endif()
    if(flag STREQUAL "--help")
      set(expected "${output}")
    elseif(NOT output STREQUAL expected)
      message(FATAL_ERROR "Help output differs for ${ARGN} -h and --help")
    endif()
  endforeach()
endfunction()

function(check_cli expected)
  execute_process(COMMAND ${EMULATOR} "${BINARY}" ${ARGN}
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT status STREQUAL "0" OR NOT errors STREQUAL "" OR NOT output STREQUAL expected)
    message(FATAL_ERROR "Unexpected runner result for ${ARGN} (${status}): ${errors}")
  endif()
endfunction()

if(MODE STREQUAL "normal")
  check_help("knurl \\[--\\] FILE")
  check_help("knurl -a auth init" -a auth)
  check_help("knurl -a auth init" --action auth)
  set(script [=[
local filename, flag = ...
assert(arg[0] == filename and arg[1] == filename and arg[2] == flag and flag == '-a')
assert(arg[-1]:match('[ /]?knurl$'))
io.write(filename, '\n')
]=])
  foreach(filename myscript auth -script)
    file(WRITE "${WORK}/${filename}" "${script}")
  endforeach()
  check_cli("myscript\n" myscript myscript -a)
  check_cli("auth\n" auth auth -a)
  check_cli("myscript\n" -a run myscript myscript -a)
  check_cli("myscript\n" --action=run myscript myscript -a)
  check_cli("-script\n" -- -script -script -a)
  check_cli("-script\n" --action run -- -script -script -a)

  get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
  file(READ "${root}/docs/knurl.md" manual)
  check_cli("${manual}" -a docs)
  set(sources "")
  set(paths curl/core.lua curl/init.lua knurl/smtp.lua lonejson/init.lua pslog/init.lua)
  set(inputs "${root}/lua/curl-core.lua" "${root}/lua/curl.lua" "${root}/lua/knurl/smtp.lua"
    "${PROVIDERS}/lonejson-lua/lua/lonejson/init.lua" "${PROVIDERS}/pslog-lua/lua/pslog/init.lua")
  foreach(path input IN ZIP_LISTS paths inputs)
    file(READ "${input}" bytes)
    string(APPEND sources "-- ===== ${path} =====\n${bytes}\n")
  endforeach()
  check_cli("${sources}" --action source)
  foreach(action run docs source unknown)
    set(args "")
    if(NOT action STREQUAL "run")
      set(args unexpected)
    endif()
    execute_process(COMMAND ${EMULATOR} "${BINARY}" -a "${action}" ${args}
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status STREQUAL "2" OR NOT output STREQUAL "" OR NOT errors MATCHES "^Usage:")
      message(FATAL_ERROR "Invalid CLI invocation accepted: ${action} ${args}")
    endif()
  endforeach()
  file(REMOVE_RECURSE "${WORK}/geo-cache")
  file(REMOVE_RECURSE "${WORK}/webdav")
  find_program(gzip gzip REQUIRED)
  foreach(fixture valid-24-4 bad-metadata)
    execute_process(COMMAND "${gzip}" -n -c "${MMDB_FIXTURES}/${fixture}.mmdb"
      OUTPUT_FILE "${WORK}/${fixture}.gz" COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
endif()
execute_process(COMMAND ${EMULATOR} "${HOST}" "${BINARY}" "${SCRIPT}" "${WORK}" "${MODE}" ${EMULATOR}
  RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "knurl application lifecycle failed (${MODE}, ${status})\n${log}${errors}")
endif()
file(READ "${WORK}/server.log" records)
if(NOT log STREQUAL "" OR NOT records MATCHES "Lua before Kore" OR
   NOT records MATCHES "Lua after Kore")
  message(FATAL_ERROR "Unexpected destination or missing direct Lua log records\n${log}${errors}\n${records}")
endif()
if(MODE STREQUAL "normal" AND (NOT records MATCHES "intentional handler error" OR
   NOT records MATCHES "stack traceback:[^\n]*binary[.]lua" OR
   NOT records MATCHES "intentional proxy on_error failure" OR
   NOT records MATCHES "intentional proxy on_exchange failure" OR
   NOT records MATCHES "\"operation\":\"on_error\"" OR
   NOT records MATCHES "\"operation\":\"on_exchange\"" OR
   NOT records MATCHES "http request[^\n]*\"path\":\"/health\"" OR
   NOT records MATCHES "Lua application call[^\n]*\"user\":\"bob\""))
  message(FATAL_ERROR "Missing handler, proxy, access, or application records\n${records}")
endif()
if((MODE STREQUAL "init-failure" AND NOT records MATCHES "intentional initializer failure") OR
   (MODE STREQUAL "stop-failure" AND NOT records MATCHES "intentional cleanup failure"))
  message(FATAL_ERROR "Missing worker failure diagnostics\n${records}")
endif()
if(MODE STREQUAL "hook-timeout")
  string(REGEX MATCHALL "[^\n]*intentional WebSocket close failure[^\n]*" failures "${records}")
  list(LENGTH failures failures_count)
  if(NOT failures_count EQUAL 7 OR NOT records MATCHES "\"operation\":\"on_close\"")
    message(FATAL_ERROR "Missing WebSocket close failure diagnostics\n${records}")
  endif()
endif()
