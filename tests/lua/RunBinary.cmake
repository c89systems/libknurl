include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/OwnedPaths.cmake")
knurl_require_owned_path("${WORK}" "Runner fixture")
file(MAKE_DIRECTORY "${WORK}")
if(MODE STREQUAL "installed")
  foreach(component Unspecified binary)
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD}" --prefix "${WORK}/installed"
      --component "${component}" RESULT_VARIABLE status OUTPUT_QUIET)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Installing knurl runner test dependencies failed (${component})")
    endif()
  endforeach()
  file(REMOVE_RECURSE "${WORK}/relocated runner")
  file(RENAME "${WORK}/installed" "${WORK}/relocated runner")
  set(BINARY "${WORK}/relocated runner/${BINDIR}/knurl")
  set(MODE normal)
  if(LOADER)
    execute_process(COMMAND "${READELF}" -lW -dW "${BINARY}"
      RESULT_VARIABLE status OUTPUT_VARIABLE elf)
    if(NOT status EQUAL 0 OR
       NOT elf MATCHES "Requesting program interpreter: /(usr/)?lib(32|64)?/ld[^/\n]+[.]so[.0-9]*\\]" OR
       elf MATCHES "NEEDED[^\n]+\\[[^]]*/[^]]*\\]")
      message(FATAL_ERROR "Unexpected installed knurl ELF metadata\n${elf}")
    endif()
    string(REGEX MATCH "(RPATH|RUNPATH)[^\n]+\\[([^]]*)\\]" path "${elf}")
    if(NOT CMAKE_MATCH_2 STREQUAL RUNPATH)
      message(FATAL_ERROR "Unexpected installed knurl runtime path: ${path}")
    endif()
  endif()
endif()
if(LOADER)
  set(runtime "${LOADER}" "${LIBRARY_PATH}")
elseif(LIBRARY_PATH)
  set(environment "${CMAKE_COMMAND}" -E env "DYLD_LIBRARY_PATH=${LIBRARY_PATH}")
endif()
execute_process(COMMAND ${environment} "${HOST}" "${BINARY}" "${SCRIPT}" "${WORK}" "${MODE}" ${runtime}
  RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "knurl application lifecycle failed (${MODE}, ${status})\n${log}${errors}")
endif()
if(MODE STREQUAL "normal" AND
   (NOT log MATCHES "intentional handler error" OR NOT log MATCHES "stack traceback:.*binary[.]lua"))
  message(FATAL_ERROR "Missing handler diagnostics\n${log}${errors}")
endif()
