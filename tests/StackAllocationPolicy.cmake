cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/OwnedPaths.cmake")
rotmos_require_owned_path("${WORK}" "Stack allocation policy fixture")
file(MAKE_DIRECTORY "${WORK}")
file(READ "${BUILD}/compile_commands.json" commands)
string(JSON count LENGTH "${commands}")
math(EXPR last "${count} - 1")
set(found FALSE)
foreach(index RANGE ${last})
  string(JSON file GET "${commands}" ${index} file)
  if(file MATCHES "/src/xml_mapping[.]c$")
    string(JSON command GET "${commands}" ${index} command)
    if(NOT command MATCHES " -Wvla( |$)" OR NOT command MATCHES " -Walloca( |$)")
      message(FATAL_ERROR "Owned Core sources must reject VLA and alloca use")
    endif()
    set(found TRUE)
    break()
  endif()
endforeach()
if(NOT found)
  message(FATAL_ERROR "Missing Core compilation command")
endif()
file(WRITE "${WORK}/fixed.c" "int test(void); int test(void) { char x[8] = {0}; return x[0]; }\n")
file(WRITE "${WORK}/vla.c" "int test(int n); int test(int n) { char x[n]; x[0] = 0; return x[0]; }\n")
file(WRITE "${WORK}/alloca.c" "int test(unsigned long n); int test(unsigned long n) { char *x = __builtin_alloca(n); x[0] = 0; return x[0]; }\n")
foreach(case fixed vla alloca)
  execute_process(COMMAND "${COMPILER}" -std=c89 -Werror -Wvla -Walloca
    -c "${WORK}/${case}.c" -o "${WORK}/${case}.o"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(case STREQUAL "fixed")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Bounded fixed buffers must compile: ${output}${errors}")
    endif()
  elseif(result EQUAL 0 OR NOT errors MATCHES "-W[^\n]*${case}")
    message(FATAL_ERROR "Expected ${case} rejection: ${output}${errors}")
  endif()
endforeach()
