cmake_minimum_required(VERSION 3.24)
include("${ROTMOS_ROOT}/cmake/OwnedPaths.cmake")
rotmos_require_owned_path("${TEST_ROOT}" "Backend dependency fixture")
file(REMOVE_RECURSE "${TEST_ROOT}")
set(project "${TEST_ROOT}/project")
set(binary "${project}/build/debug")
file(MAKE_DIRECTORY "${project}/vendor/kore/src" "${project}/patches/kore" "${project}/cmake")
file(COPY "${ROTMOS_ROOT}/cmake/KoreSources.cmake" "${ROTMOS_ROOT}/cmake/PrepareKore.cmake"
  "${ROTMOS_ROOT}/cmake/OwnedPaths.cmake"
  DESTINATION "${project}/cmake")
file(WRITE "${project}/vendor/kore.revision" "0123456789012345678901234567890123456789\n")
file(WRITE "${project}/vendor/kore.url" "unused fixture\n")
file(WRITE "${project}/vendor/kore/src/kore.c" "int main(void) { return 0; }\n")
file(WRITE "${project}/patches/kore/series" "change.patch\n")
file(WRITE "${project}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(backend_dependency_fixture LANGUAGES C)
include(cmake/KoreSources.cmake)
set(prepared "${CMAKE_CURRENT_BINARY_DIR}/kore")
rotmos_add_kore_sources("${CMAKE_CURRENT_SOURCE_DIR}" "${prepared}")
set(source "${prepared}/src/kore.c")
set_source_files_properties("${source}" PROPERTIES GENERATED TRUE)
rotmos_kore_object_dependencies("${prepared}/.patched" "${source}")
add_executable(fixture "${source}")
add_dependencies(fixture kore-source)
target_compile_options(fixture PRIVATE -std=c89 -Werror -Wpedantic)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  target_link_options(fixture PRIVATE -static)
endif()
]=])
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE diagnostic)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Backend dependency command failed: ${ARGV}\n${log}${diagnostic}")
  endif()
endfunction()
function(write_patch value)
  file(WRITE "${project}/patches/kore/change.patch"
    "--- a/src/kore.c\n+++ b/src/kore.c\n@@ -1 +1 @@\n-int main(void) { return 0; }\n+int main(void) { return ${value}; }\n")
endfunction()
function(check_exit expected)
  if(ROTMOS_CAN_RUN)
    execute_process(COMMAND "${binary}/fixture" RESULT_VARIABLE actual)
    if(NOT actual STREQUAL "${expected}")
      message(FATAL_ERROR "Prepared backend compiled stale source: expected ${expected}, got ${actual}")
    endif()
  endif()
endfunction()
write_patch(1)
run("${CMAKE_COMMAND}" -S "${project}" -B "${binary}" -G Ninja
  "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}" "-DROTMOS_TARGET=${ROTMOS_TARGET}")
run("${CMAKE_COMMAND}" --build "${binary}" --parallel 1)
check_exit(1)
file(SHA256 "${binary}/fixture" before)
run("${CMAKE_COMMAND}" -E sleep 1)
write_patch(2)
# This single invocation must prepare, compile AND link the changed backend.
run("${CMAKE_COMMAND}" --build "${binary}" --parallel 1)
check_exit(2)
file(SHA256 "${binary}/fixture" after)
if(before STREQUAL after)
  message(FATAL_ERROR "Patch change did not change the compiled backend")
endif()
