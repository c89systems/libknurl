cmake_minimum_required(VERSION 3.24)
include("${ROTMOS_ROOT}/cmake/OwnedPaths.cmake")
rotmos_require_owned_path("${TEST_ROOT}" "Kore ownership fixture")
file(REMOVE_RECURSE "${TEST_ROOT}")
set(owner "${TEST_ROOT}/owner")
set(source "${owner}/vendor/kore")
set(patches "${owner}/patches/kore")
file(MAKE_DIRECTORY "${owner}/cmake" "${source}/src" "${patches}" "${TEST_ROOT}/borrowed")
file(COPY "${ROTMOS_ROOT}/cmake/PrepareKore.cmake" "${ROTMOS_ROOT}/cmake/OwnedPaths.cmake"
  DESTINATION "${owner}/cmake")
file(WRITE "${source}/src/kore.c" "upstream\n")
file(WRITE "${patches}/series" "change.patch\n")
file(WRITE "${patches}/change.patch" "--- a/src/kore.c\n+++ b/src/kore.c\n@@ -1 +1 @@\n-upstream\n+patched\n")
function(prepare source patches output success pattern)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DKORE_SOURCE=${source}"
    "-DKORE_PATCHES=${patches}" "-DKORE_OUTPUT=${output}"
    -P "${owner}/cmake/PrepareKore.cmake"
    RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if((success AND NOT code EQUAL 0) OR
      (NOT success AND (code EQUAL 0 OR NOT "${log}${errors}" MATCHES "${pattern}")))
    message(FATAL_ERROR "Unexpected preparation ownership result: ${log}${errors}")
  endif()
endfunction()
function(preserved path expected)
  file(READ "${path}" bytes)
  if(NOT bytes STREQUAL expected)
    message(FATAL_ERROR "Preparation modified input: ${path}")
  endif()
endfunction()
prepare("${source}" "${patches}" "${owner}/build/prepared" TRUE "")
preserved("${owner}/build/prepared/src/kore.c" "patched\n")
# A staging directory is a cleanup destination too, including its descendants.
file(MAKE_DIRECTORY "${owner}/build/collision.staging/src")
file(WRITE "${owner}/build/collision.staging/src/kore.c" "upstream\n")
prepare("${owner}/build/collision.staging" "${patches}" "${owner}/build/collision" FALSE "overlap")
preserved("${owner}/build/collision.staging/src/kore.c" "upstream\n")
file(MAKE_DIRECTORY "${owner}/build/nested.staging/source/src")
file(WRITE "${owner}/build/nested.staging/source/src/kore.c" "upstream\n")
prepare("${owner}/build/nested.staging/source" "${patches}" "${owner}/build/nested" FALSE "overlap")
preserved("${owner}/build/nested.staging/source/src/kore.c" "upstream\n")
foreach(directory "${owner}/build/patch-collision.staging" "${owner}/build/patch-output/patches")
  file(COPY "${patches}/" DESTINATION "${directory}")
endforeach()
prepare("${source}" "${owner}/build/patch-collision.staging"
  "${owner}/build/patch-collision" FALSE "overlap")
preserved("${owner}/build/patch-collision.staging/series" "change.patch\n")
prepare("${source}" "${owner}/build/patch-output/patches"
  "${owner}/build/patch-output" FALSE "overlap")
preserved("${owner}/build/patch-output/patches/series" "change.patch\n")
# Patch inputs must belong to the same checkout as the source export.
file(COPY "${patches}/" DESTINATION "${TEST_ROOT}/borrowed/patches")
prepare("${source}" "${TEST_ROOT}/borrowed/patches" "${owner}/build/foreign" FALSE "KORE_PATCHES")
file(REMOVE "${patches}/change.patch")
file(CREATE_LINK "${TEST_ROOT}/borrowed/patches/change.patch" "${patches}/change.patch" SYMBOLIC)
prepare("${source}" "${patches}" "${owner}/build/linked-patch" FALSE "symlink")
file(REMOVE "${patches}/change.patch")
file(COPY "${TEST_ROOT}/borrowed/patches/change.patch" DESTINATION "${patches}")
file(REMOVE "${patches}/series")
file(CREATE_LINK "${TEST_ROOT}/borrowed/patches/series" "${patches}/series" SYMBOLIC)
prepare("${source}" "${patches}" "${owner}/build/linked-series" FALSE "symlink")
file(REMOVE "${patches}/series")
file(COPY "${TEST_ROOT}/borrowed/patches/series" DESTINATION "${patches}")
# Raw output paths and derived staging paths share the generated-path contract.
file(MAKE_DIRECTORY "${TEST_ROOT}/borrowed/nested")
file(CREATE_LINK "${TEST_ROOT}/borrowed/nested" "${owner}/build/link" SYMBOLIC)
prepare("${source}" "${patches}" "${owner}/build/link/../raw" FALSE "symlink")
file(CREATE_LINK "${TEST_ROOT}/borrowed" "${owner}/build/linked.staging" SYMBOLIC)
prepare("${source}" "${patches}" "${owner}/build/linked" FALSE "symlink")
preserved("${source}/src/kore.c" "upstream\n")
