cmake_minimum_required(VERSION 3.24)
if(PLATFORM STREQUAL "Darwin")
  set(flags -g -U)
else()
  set(flags -D --defined-only)
endif()
execute_process(COMMAND "${NM}" ${flags} "${LIBRARY}"
  RESULT_VARIABLE result OUTPUT_VARIABLE symbols ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect shared-library exports: ${errors}")
endif()
if(symbols MATCHES "[ _]knurl_(executors?_|job_|framer_)")
  message(FATAL_ERROR "Private executor/framer machinery leaked into shared exports")
endif()
if(symbols MATCHES "[ _](MMDB_|data_pool_|can_multiply|knurl_mmdb_(vendor_|maxmind_open|native_open|cache_|decode|skip|select|read|equal|same|integer))")
  message(FATAL_ERROR "Private or removed MMDB implementation leaked into shared exports")
endif()
if(symbols MATCHES "[ _](knurl_response_(head|pretty|file_metadata)|http_response_(head_build|error_body|file_metadata))([ \r\n]|$)")
  message(FATAL_ERROR "Private backend response codec leaked into shared exports")
endif()
