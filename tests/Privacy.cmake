cmake_minimum_required(VERSION 3.24)
include("${KNURL_ROOT}/cmake/OwnedPaths.cmake")
knurl_require_owned_path("${TEST_ROOT}" "Privacy fixture")
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
function(probe content pattern)
  file(WRITE "${TEST_ROOT}/payload" "${content}")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DPRIVACY_FILE=${TEST_ROOT}/payload"
    -P "${KNURL_ROOT}/cmake/Privacy.cmake"
    RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if(pattern STREQUAL "")
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "Privacy guard rejected ordinary public content: ${errors}")
    endif()
  elseif(code EQUAL 0 OR NOT "${log}${errors}" MATCHES "${pattern}")
    message(FATAL_ERROR "Privacy guard missed expected violation: ${pattern}")
  endif()
endfunction()
probe("private_key = key_reference; access_token = PLACEHOLDER; ghp_REDACTED" "")
probe([=[tool="$extract/root/bin"]=] "")
probe("-----BEGIN PRIVATE KEY-----" "")
probe("-----BEGIN CERTIFICATE-----\npublic certificate data\n-----END CERTIFICATE-----" "")
probe("-----BEGIN PRIVATE KEY-----\nREDACTED\n-----END PRIVATE KEY-----" "")
foreach(path "/home/fixture/work" "/Users/fixture/work" "/root/work"
    "/private/var/folders/work" "${KNURL_ROOT}/build/private")
  probe("path=${path}" "Private path/instrumentation")
endforeach()
foreach(marker __afl_area_ptr __asan_init __ubsan_handle_abort -fsanitize=address)
  probe("${marker}" "Private path/instrumentation")
endforeach()
string(REPEAT A 64 body)
string(REPEAT "AA\n" 32 short_lines)
probe("-----BEGIN PRIVATE KEY-----\n${short_lines}-----END PRIVATE KEY-----\n"
  "Private key/credential")
string(ASCII 1 2 3 binary)
set(redacted "-----BEGIN PRIVATE KEY-----\nREDACTED\n-----END PRIVATE KEY-----\n")
string(REPEAT "${redacted}" 6 examples)
probe("${examples}" "")
probe("${examples}-----BEGIN PRIVATE KEY-----\n${body}\n-----END PRIVATE KEY-----\n"
  "Private key/credential")
foreach(kind "PRIVATE KEY" "RSA PRIVATE KEY" "EC PRIVATE KEY" "DSA PRIVATE KEY"
    "OPENSSH PRIVATE KEY" "ENCRYPTED PRIVATE KEY")
  probe("${binary}\n-----BEGIN ${kind}-----\n${body}\n-----END ${kind}-----\n"
    "Private key/credential")
endforeach()
probe("-----BEGIN RSA PRIVATE KEY-----\nProc-Type: 4,ENCRYPTED\nDEK-Info: AES-256-CBC,0123456789ABCDEF\n\n${body}\n-----END RSA PRIVATE KEY-----\n"
  "Private key/credential")
string(REPEAT A 36 suffix)
foreach(prefix ghp_ gho_ ghu_ ghs_ ghr_)
  probe("${binary}${prefix}${suffix}" "Private key/credential")
endforeach()
probe("github_pat_${body}" "Private key/credential")
# Error diagnostics identify the artifact and class, never the matched value.
file(READ "${TEST_ROOT}/payload" token)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DPRIVACY_FILE=${TEST_ROOT}/payload"
  -P "${KNURL_ROOT}/cmake/Privacy.cmake" OUTPUT_VARIABLE log ERROR_VARIABLE errors)
string(FIND "${log}${errors}" "${token}" leaked)
if(NOT leaked EQUAL -1)
  message(FATAL_ERROR "Privacy diagnostics disclosed matched content")
endif()
