cmake_minimum_required(VERSION 3.24)
include("${ROTMOS_ROOT}/cmake/OwnedPaths.cmake")
rotmos_require_owned_path("${TEST_ROOT}" "Lua artifact fixture")
find_program(BASH bash REQUIRED)
find_program(UNZIP unzip REQUIRED)
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Lua artifact check failed: ${ARGV}\n${output}${errors}")
  endif()
endfunction()
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/extract" "${TEST_ROOT}/nested")
include("${ROTMOS_ROOT}/cmake/Version.cmake")
rotmos_version("${ROTMOS_ROOT}" version)
set(package "lua-rotmos-${version}")
run("${CMAKE_COMMAND}" "-DOUTPUT_DIR=${TEST_ROOT}/products"
  "-DROTMOS_CANDIDATE_VERSION=${ROTMOS_CANDIDATE_VERSION}"
  -P "${ROTMOS_ROOT}/lua/cmake/Package.cmake")
file(STRINGS "${TEST_ROOT}/products/${package}-CHECKSUMS" checksums)
set(expected "${package}.tar.gz" "${package}-1.rockspec" "${package}-1.src.rock")
set(actual)
foreach(entry IN LISTS checksums)
  string(SUBSTRING "${entry}" 0 64 expected_digest)
  string(SUBSTRING "${entry}" 66 -1 name)
  list(APPEND actual "${name}")
  file(SHA256 "${TEST_ROOT}/products/${name}" digest)
  if(NOT digest STREQUAL expected_digest)
    message(FATAL_ERROR "Lua artifact checksum mismatch: ${name}")
  endif()
endforeach()
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Incomplete Lua product inventory: ${actual}")
endif()
run("${CMAKE_COMMAND}" -E env TZ=Pacific/Honolulu "${BASH}" -c
  [=[umask 077 && exec "$@"]=] -- "${CMAKE_COMMAND}"
  "-DROTMOS_CANDIDATE_VERSION=${ROTMOS_CANDIDATE_VERSION}"
  "-DOUTPUT_DIR=${TEST_ROOT}/repeat" -P "${ROTMOS_ROOT}/lua/cmake/Package.cmake")
file(STRINGS "${TEST_ROOT}/repeat/${package}-CHECKSUMS" repeated)
if(NOT checksums STREQUAL repeated)
  message(FATAL_ERROR "Lua artifacts changed with staging umask/timezone")
endif()
file(ARCHIVE_EXTRACT INPUT "${TEST_ROOT}/products/${package}.tar.gz"
  DESTINATION "${TEST_ROOT}/extract")
set(source "${TEST_ROOT}/extract/${package}")
file(STRINGS "${source}/lua/source-manifest.txt" expected)
file(STRINGS "${source}/RELEASE_MANIFEST" entries)
set(actual)
foreach(entry IN LISTS entries)
  string(SUBSTRING "${entry}" 0 64 expected_digest)
  string(SUBSTRING "${entry}" 66 -1 name)
  list(APPEND actual "${name}")
  file(SHA256 "${source}/${name}" digest)
  if(NOT digest STREQUAL expected_digest)
    message(FATAL_ERROR "Lua source byte mismatch: ${name}")
  endif()
endforeach()
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Lua release/source manifests disagree")
endif()
file(GLOB_RECURSE payload LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/*")
list(APPEND expected RELEASE_MANIFEST)
list(SORT payload)
list(SORT expected)
if(NOT payload STREQUAL expected)
  message(FATAL_ERROR "Unexpected Lua source payload: ${payload}")
endif()
foreach(name IN LISTS payload)
  file(READ "${source}/${name}" bytes)
  if(bytes MATCHES "${ROTMOS_ROOT}" OR bytes MATCHES "/home/[^ /]+/")
    message(FATAL_ERROR "Workstation path in Lua source: ${name}")
  endif()
endforeach()
run("${UNZIP}" -q "${TEST_ROOT}/products/${package}-1.src.rock" -d "${TEST_ROOT}/nested")
file(GLOB nested RELATIVE "${TEST_ROOT}/nested" "${TEST_ROOT}/nested/*")
set(expected "${package}-1.rockspec" "${package}.tar.gz")
if(NOT nested STREQUAL expected)
  message(FATAL_ERROR "Unexpected source-rock payload: ${nested}")
endif()
foreach(name IN LISTS expected)
  run("${CMAKE_COMMAND}" -E compare_files "${TEST_ROOT}/products/${name}"
    "${TEST_ROOT}/nested/${name}")
endforeach()
# Exercise rejection without altering the checkout's manifest or sources.
file(APPEND "${source}/lua/source-manifest.txt" "\n../outside\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DOUTPUT_DIR=${source}/build/rejected"
  -P "${source}/lua/cmake/Package.cmake" RESULT_VARIABLE rejected
  OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(rejected EQUAL 0 OR NOT errors MATCHES "Invalid Lua source-manifest input")
  message(FATAL_ERROR "Unsafe source input was not rejected: ${output}${errors}")
endif()
configure_file("${ROTMOS_ROOT}/lua/source-manifest.txt"
  "${source}/lua/source-manifest.txt" COPYONLY)
execute_process(COMMAND "${BASH}" "${source}/lua/build-rock.sh" native "${source}" "${source}"
  RESULT_VARIABLE rejected OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(rejected EQUAL 0 OR NOT errors MATCHES "unsupported target: native")
  message(FATAL_ERROR "Unselected compiler target was not rejected: ${output}${errors}")
endif()
