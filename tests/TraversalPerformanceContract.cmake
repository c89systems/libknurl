cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/OwnedPaths.cmake")
rotmos_require_owned_path("${WORK}" "Performance contract fixture directory")
file(MAKE_DIRECTORY "${WORK}")
set(baseline "")
set(accepted "")
set(rejected "")
foreach(round RANGE 1 3)
  foreach(key RANGE 1 8)
    string(APPEND baseline "case-${key} 100\n")
    string(APPEND accepted "case-${key} 104\n")
    string(APPEND rejected "case-${key} 106\n")
  endforeach()
endforeach()
file(WRITE "${WORK}/baseline.tsv" "${baseline}")
file(WRITE "${WORK}/accepted.tsv" "${accepted}")
file(WRITE "${WORK}/rejected.tsv" "${rejected}")
execute_process(COMMAND "${BENCHMARK}" --compare
  "${WORK}/baseline.tsv" "${WORK}/accepted.tsv"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "A 4% increase must pass: ${output}${errors}")
endif()
execute_process(COMMAND "${BENCHMARK}" --compare
  "${WORK}/baseline.tsv" "${WORK}/rejected.tsv"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 1 OR NOT errors MATCHES "5% CPU-time regression budget")
  message(FATAL_ERROR "A 6% increase must fail: ${output}${errors}")
endif()
