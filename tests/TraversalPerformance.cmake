cmake_minimum_required(VERSION 3.24)
foreach(binary BASELINE CANDIDATE)
  if(NOT DEFINED ${binary} OR NOT EXISTS "${${binary}}")
    message(FATAL_ERROR "Provide ${binary} as a built Release benchmark executable")
  endif()
endforeach()
if(NOT OUTPUT_DIR)
  message(FATAL_ERROR "Provide an owned OUTPUT_DIR for the comparison logs")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/OwnedPaths.cmake")
rotmos_require_owned_path("${OUTPUT_DIR}" "Performance comparison directory")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${OUTPUT_DIR}/baseline.tsv" "")
file(WRITE "${OUTPUT_DIR}/candidate.tsv" "")
# Alternate the two executables. Each reports five-sample process-CPU medians;
# the executable comparator asserts the median of three paired runs per case.
foreach(round RANGE 1 3)
  foreach(kind BASELINE CANDIDATE)
    execute_process(COMMAND "${${kind}}" RESULT_VARIABLE result
      OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${kind} benchmark failed: ${result}\n${output}${errors}")
    endif()
    string(TOLOWER "${kind}" log)
    file(APPEND "${OUTPUT_DIR}/${log}.tsv" "${output}")
  endforeach()
endforeach()
execute_process(COMMAND "${CANDIDATE}" --compare
  "${OUTPUT_DIR}/baseline.tsv" "${OUTPUT_DIR}/candidate.tsv"
  RESULT_VARIABLE result OUTPUT_VARIABLE comparison ERROR_VARIABLE errors)
file(WRITE "${OUTPUT_DIR}/comparison.txt" "${comparison}${errors}")
message("${comparison}${errors}")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Traversal performance assertions failed")
endif()
