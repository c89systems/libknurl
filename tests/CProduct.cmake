cmake_minimum_required(VERSION 3.24)
include("${KNURL_ROOT}/cmake/OwnedPaths.cmake")
knurl_require_owned_path("${TEST_ROOT}" "C product fixture")
file(MAKE_DIRECTORY "${TEST_ROOT}")
find_program(MAKE make REQUIRED)
# Make accepts an existing directory as a goal. Probe the old packaging and
# executable rules now that the configuration module lives in lua/.
foreach(target lua-all lua-package knurl binary-test binary-package)
  execute_process(COMMAND "${MAKE}" -n -C "${KNURL_ROOT}" "${target}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(code EQUAL 0 OR NOT "${output}${errors}" MATCHES "No rule to make target")
    message(FATAL_ERROR "Deferred product still has an active Make target: ${target}: ${output}${errors}")
  endif()
endforeach()
foreach(product lua binary)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${KNURL_ROOT}/archive/pre-luthrum/${product}"
    -B "${TEST_ROOT}/${product}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(code EQUAL 0 OR NOT "${output}${errors}" MATCHES "deferred until Luthrum")
    message(FATAL_ERROR "Archive unexpectedly configured: ${product}: ${output}${errors}")
  endif()
  set(packager "${KNURL_ROOT}/archive/pre-luthrum/binary/Package.cmake")
  if(product STREQUAL "lua")
    set(packager "${KNURL_ROOT}/archive/pre-luthrum/lua/cmake/Package.cmake")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -P "${packager}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(code EQUAL 0 OR NOT "${output}${errors}" MATCHES "deferred until Luthrum")
    message(FATAL_ERROR "Archive unexpectedly packaged: ${product}: ${output}${errors}")
  endif()
endforeach()
foreach(path src/lua cmake/VerifyLuaPackage.cmake tests/SourceInputs.cmake)
  if(EXISTS "${KNURL_ROOT}/${path}")
    message(FATAL_ERROR "Deferred product returned to the active source layout: ${path}")
  endif()
endforeach()
file(STRINGS "${KNURL_ROOT}/scripts/dependency-pins.tsv" pins REGEX "^[^#]")
set(lua_pins "")
foreach(pin IN LISTS pins)
  if(pin MATCHES "^lua\t(pslog\t0[.]13[.]0|lonejson\t0[.]50[.]0)\tall\t")
    list(APPEND lua_pins "${CMAKE_MATCH_1}")
  elseif(NOT pin MATCHES "^sdk\t(cpkt|lonejson|pslog)\t")
    message(FATAL_ERROR "Unexpected dependency in active acquisition inventory")
  endif()
endforeach()
list(SORT lua_pins)
if(NOT lua_pins STREQUAL "lonejson\t0.50.0;pslog\t0.13.0")
  message(FATAL_ERROR "Expected pinned sources for the optional Lua providers")
endif()
message(STATUS "The archived runtime binding and executable cannot build or package")
include("${KNURL_ROOT}/cmake/PublicDocs.cmake")
knurl_verify_public_docs("${KNURL_ROOT}" "${KNURL_ROOT}")
file(GLOB_RECURSE archived_guides "${KNURL_ROOT}/archive/*.md")
foreach(guide IN LISTS archived_guides)
  file(READ "${guide}" text)
  string(REGEX MATCHALL "\\[[^]\r\n]+\\]\\([^() \t\r\n]+\\)" links "${text}")
  get_filename_component(directory "${guide}" DIRECTORY)
  foreach(link IN LISTS links)
    string(REGEX REPLACE "^\\[[^]]+\\]\\(|\\)$" "" target "${link}")
    if(target MATCHES "^([a-zA-Z][a-zA-Z0-9+.-]*:|#)")
      continue()
    endif()
    string(REGEX REPLACE "#.*$" "" target "${target}")
    cmake_path(ABSOLUTE_PATH target BASE_DIRECTORY "${directory}" NORMALIZE)
    cmake_path(IS_PREFIX KNURL_ROOT "${target}" NORMALIZE inside)
    if(NOT inside OR NOT EXISTS "${target}")
      message(FATAL_ERROR "Broken archive link in ${guide}: ${link}")
    endif()
  endforeach()
endforeach()
