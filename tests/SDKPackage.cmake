cmake_minimum_required(VERSION 3.24)
set(output "${BUILD_DIR}/tests/sdk-package")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "SDK package fixture failed: ${ARGV}\n${log}${errors}")
  endif()
endfunction()
include("${BUILD_DIR}/sdk-build.cmake")
set(package "librotmos-${SDK_VERSION}-${SDK_TARGET}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DBUILD_DIR=${BUILD_DIR}"
  "-DOUTPUT_DIR=${SDK_ROOT}/dist/sdk-binary-rehearsal" -P "${SDK_ROOT}/cmake/Package.cmake"
  RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(result EQUAL 0 OR NOT errors MATCHES "binary rehearsals must stay under")
  message(FATAL_ERROR "SDK binary rehearsal escaped build/: ${log}${errors}")
endif()
run("${CMAKE_COMMAND}" "-DBUILD_DIR=${BUILD_DIR}" "-DOUTPUT_DIR=${output}" -P "${SDK_ROOT}/cmake/Package.cmake")
file(SHA256 "${output}/${package}.tar.gz" first)
# A restrictive staging umask must not change shipped bytes.
run(bash -c "umask 077; exec \"$@\"" sdk-package
  "${CMAKE_COMMAND}" "-DBUILD_DIR=${BUILD_DIR}" "-DOUTPUT_DIR=${output}" -P "${SDK_ROOT}/cmake/Package.cmake")
file(SHA256 "${output}/${package}.tar.gz" second)
if(NOT first STREQUAL second)
  message(FATAL_ERROR "SDK package depends on staging timestamps/umask")
endif()
# Keep the final rehearsal bytes intact while negative cases mutate their own
# copy. Verify the final path once, including its relocated consumers.
file(MAKE_DIRECTORY "${BUILD_DIR}/packages")
foreach(name "${package}.tar.gz" "${package}-BINARY-CHECKSUMS")
  configure_file("${output}/${name}" "${BUILD_DIR}/packages/${name}" COPYONLY)
endforeach()
run("${CMAKE_COMMAND}" "-DBUILD_DIR=${BUILD_DIR}" "-DOUTPUT_DIR=${BUILD_DIR}/packages" -P "${SDK_ROOT}/cmake/VerifySDK.cmake")
# The public verifier must reject altered final bytes before extraction/build.
file(APPEND "${output}/${package}.tar.gz" "modified")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DBUILD_DIR=${BUILD_DIR}" "-DOUTPUT_DIR=${output}"
  -P "${SDK_ROOT}/cmake/VerifySDK.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(result EQUAL 0 OR NOT errors MATCHES "checksum inventory does not match")
  message(FATAL_ERROR "SDK checksum corruption was not rejected: ${log}${errors}")
endif()
set(extracted "${BUILD_DIR}/package-verification/relocated SDK")
set(fixture "${BUILD_DIR}/tests/sdk-package-bytes")
file(REMOVE_RECURSE "${fixture}")
file(MAKE_DIRECTORY "${fixture}")
file(RENAME "${extracted}" "${fixture}/${package}")
function(reject_bytes expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${output}/${package}.tar.gz"
    --format=gnutar "${package}" WORKING_DIRECTORY "${fixture}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot construct SDK negative fixture")
  endif()
  file(SHA256 "${output}/${package}.tar.gz" digest)
  file(WRITE "${output}/${package}-BINARY-CHECKSUMS" "${digest}  ${package}.tar.gz\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DBUILD_DIR=${BUILD_DIR}" "-DOUTPUT_DIR=${output}"
    -P "${SDK_ROOT}/cmake/VerifySDK.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if(result EQUAL 0 OR NOT errors MATCHES "${expected}")
    message(FATAL_ERROR "SDK invalid bytes were not rejected (${expected}): ${log}${errors}")
  endif()
endfunction()
file(WRITE "${fixture}/${package}/include/rotmos/executor.h" "private\n")
reject_bytes("final inventory mismatch")
file(REMOVE "${fixture}/${package}/include/rotmos/executor.h")
set(readme "${fixture}/${package}/share/rotmos/README.md")
file(SHA256 "${readme}" before)
file(APPEND "${readme}" "\n/home/fixture/private-checkout\n")
file(SHA256 "${readme}" after)
set(inventory "${fixture}/${package}/share/rotmos/RELEASE_MANIFEST")
file(READ "${inventory}" records)
string(REPLACE "${before}  share/rotmos/README.md" "${after}  share/rotmos/README.md" records "${records}")
file(WRITE "${inventory}" "${records}")
reject_bytes("Private path/instrumentation")
file(READ "${readme}" bytes)
string(REPLACE "/home/fixture/private-checkout" "__afl_area_ptr" bytes "${bytes}")
file(WRITE "${readme}" "${bytes}")
file(SHA256 "${readme}" afl_digest)
string(REPLACE "${after}  share/rotmos/README.md" "${afl_digest}  share/rotmos/README.md" records "${records}")
file(WRITE "${inventory}" "${records}")
reject_bytes("Private path/instrumentation")
# Remove the intentionally corrupt fixture instead of leaving a candidate.
file(REMOVE "${output}/${package}.tar.gz" "${output}/${package}-BINARY-CHECKSUMS")
file(REMOVE_RECURSE "${fixture}")
