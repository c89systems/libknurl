cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/OwnedPaths.cmake")
knurl_require_owned_path("${OUTPUT_DIR}" "MMDB benchmark output")
if(NOT EXISTS "${BENCHMARK}" OR NOT EXISTS "${DATABASE}")
  message(FATAL_ERROR "Provide built Release BENCHMARK and local DATABASE")
endif()
if(PROBE AND NOT EXISTS "${PROBE}")
  message(FATAL_ERROR "PROBE must name the instrumented benchmark executable")
endif()
if(NOT DEFINED HEAP_LIMITS OR HEAP_LIMITS STREQUAL "")
  set(HEAP_LIMITS 8192 65536 262144)
endif()
if(NOT DEFINED ROUNDS)
  set(ROUNDS 5)
endif()
if(NOT DEFINED PATTERNS)
  set(PATTERNS random hot)
endif()
if(NOT PATTERNS)
  message(FATAL_ERROR "PATTERNS must contain random and/or hot")
endif()
foreach(pattern IN LISTS PATTERNS)
  if(NOT pattern MATCHES "^(random|hot)$")
    message(FATAL_ERROR "PATTERNS must contain random and/or hot")
  endif()
endforeach()
if(NOT DEFINED ADDRESS_COUNT)
  set(ADDRESS_COUNT 65536)
endif()
if(NOT ADDRESS_COUNT MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "ADDRESS_COUNT must be positive")
endif()
if(NOT ROUNDS MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "ROUNDS must be a positive integer")
endif()
foreach(limit IN LISTS HEAP_LIMITS)
  if(NOT limit MATCHES "^[0-9]+$")
    message(FATAL_ERROR "HEAP_LIMITS must contain unsigned byte counts")
  endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(SHA256 "${DATABASE}" digest)
get_filename_component(name "${DATABASE}" NAME)
file(WRITE "${OUTPUT_DIR}/comparison.txt" "database=${name}\ndatabase_sha256=${digest}\naddress_count=${ADDRESS_COUNT}\n")
foreach(round RANGE 1 ${ROUNDS})
  math(EXPR odd "${round} % 2")
  set(limits ${HEAP_LIMITS})
  if(NOT odd)
    list(REVERSE limits)
  endif()
  foreach(pattern IN LISTS PATTERNS)
    foreach(limit IN LISTS limits)
      execute_process(COMMAND "${BENCHMARK}" "${DATABASE}" ${pattern} ${limit} ${ADDRESS_COUNT}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "Heap limit ${limit} benchmark failed: ${result}\n${output}${errors}")
      endif()
      if(NOT output MATCHES "checksum=([0-9]+)")
        message(FATAL_ERROR "Missing result checksum: ${output}")
      endif()
      if(DEFINED checksum_${pattern} AND NOT CMAKE_MATCH_1 STREQUAL checksum_${pattern})
        message(FATAL_ERROR "Cache limits produced different results for ${pattern}")
      endif()
      set(checksum_${pattern} "${CMAKE_MATCH_1}")
      file(APPEND "${OUTPUT_DIR}/comparison.txt" "${output}")
      message(STATUS "${output}")
    endforeach()
  endforeach()
endforeach()
if(PROBE)
  file(WRITE "${OUTPUT_DIR}/heap.txt" "database=${name}\ndatabase_sha256=${digest}\n")
  foreach(pattern IN LISTS PATTERNS)
    foreach(limit IN LISTS HEAP_LIMITS)
      execute_process(COMMAND "${PROBE}" "${DATABASE}" ${pattern} ${limit} ${ADDRESS_COUNT}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "Heap probe ${limit} failed: ${result}\n${output}${errors}")
      endif()
      if(NOT output MATCHES "checksum=([0-9]+)" OR
          NOT CMAKE_MATCH_1 STREQUAL checksum_${pattern})
        message(FATAL_ERROR "Heap probe result checksum differs for ${pattern}")
      endif()
      if(NOT output MATCHES "reader_peak_heap=([0-9]+)")
        message(FATAL_ERROR "Missing heap probe statistics: ${output}")
      endif()
      set(effective_limit ${limit})
      if(limit EQUAL 0)
        set(effective_limit 524288)
      endif()
      if(CMAKE_MATCH_1 GREATER effective_limit OR NOT output MATCHES "retained_after_close=0")
        message(FATAL_ERROR "Reader exceeded its heap limit or leaked: ${output}")
      endif()
      file(APPEND "${OUTPUT_DIR}/heap.txt" "${output}")
    endforeach()
  endforeach()
endif()
