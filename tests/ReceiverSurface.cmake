cmake_minimum_required(VERSION 3.24)
# Every handle operation must be reachable from its public receiver. This catches
# additions to the free-function API that omit the corresponding receiver method.
file(GLOB headers "${KNURL_ROOT}/include/knurl/*.h")
file(GLOB sources "${KNURL_ROOT}/src/*.c")
foreach(source IN LISTS sources)
  file(READ "${source}" text)
  string(REGEX MATCHALL "static const knurl_[a-z_]+ methods = \\{[^}]+\\}" found "${text}")
  foreach(table IN LISTS found)
    string(REGEX MATCH "static const (knurl_[a-z_]+) methods" ignored "${table}")
    set("receiver_${CMAKE_MATCH_1}" "${table}")
  endforeach()
endforeach()
set(operations 0)
foreach(header IN LISTS headers)
  file(READ "${header}" text)
  string(REGEX MATCHALL "KNURL_API[^;]+;" declarations "${text}")
  foreach(declaration IN LISTS declarations)
    if(NOT declaration MATCHES "(knurl_[a-z0-9_]+)[ \t\r\n]*\\([ \t\r\n]*(const[ \t\r\n]+)?(knurl_[a-z_]+)[ \t\r\n]*\\*[ \t\r\n]*[a-z_]*[ \t\r\n]*[,)]")
      continue()
    endif()
    set(operation "${CMAKE_MATCH_1}")
    set(receiver "${CMAKE_MATCH_3}")
    if(NOT DEFINED "receiver_${receiver}")
      continue()
    endif()
    if(NOT "${receiver_${receiver}}" MATCHES "[{ \t\r\n]${operation}[ \t\r\n]*,")
      message(FATAL_ERROR "${operation} is missing from the ${receiver} receiver")
    endif()
    math(EXPR operations "${operations} + 1")
  endforeach()
endforeach()
if(operations EQUAL 0)
  message(FATAL_ERROR "Receiver inventory is incomplete: ${operations} operations")
endif()
message(STATUS "Verified ${operations} public operations on their receivers")
