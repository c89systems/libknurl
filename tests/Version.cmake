cmake_minimum_required(VERSION 3.24)
include("${KNURL_ROOT}/cmake/OwnedPaths.cmake")
knurl_require_owned_path("${TEST_ROOT}" "Version fixture")
find_program(GIT git REQUIRED)
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/owner/sub" "${TEST_ROOT}/source")
function(git)
  execute_process(COMMAND "${GIT}" -C "${TEST_ROOT}/owner" ${ARGV}
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Git fixture: ${ARGV}: ${output}${error}")
  endif()
endfunction()
git(init -q)
git(-c user.name=fixture -c user.email=fixture@example.invalid -c commit.gpgsign=false
  commit --allow-empty -qm fixture)
file(WRITE "${TEST_ROOT}/probe.cmake"
  "include(\"${KNURL_ROOT}/cmake/Version.cmake\")\nknurl_version(\"\${SOURCE}\" value)\nif(NOT value STREQUAL EXPECTED)\nmessage(FATAL_ERROR \"Expected \${EXPECTED}; got \${value}\")\nendif()\n")
function(probe path expected success)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${path}" "-DEXPECTED=${expected}" ${ARGN}
    -P "${TEST_ROOT}/probe.cmake" RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if((success AND NOT code EQUAL 0) OR (NOT success AND code EQUAL 0))
    message(FATAL_ERROR "Version probe: ${path}: ${log}${errors}")
  endif()
endfunction()
probe("${TEST_ROOT}/owner" 0.0.0 TRUE)
file(WRITE "${TEST_ROOT}/owner/VERSION" "99.0.0\n")
probe("${TEST_ROOT}/owner" 0.0.0 TRUE)
probe("${TEST_ROOT}/owner" 1.2.3 TRUE -DKNURL_CANDIDATE_VERSION=1.2.3)
probe("${TEST_ROOT}/owner" unused FALSE -DKNURL_CANDIDATE_VERSION=01.2.3)
git(-c tag.gpgsign=false tag v1.2.3)
probe("${TEST_ROOT}/owner" 1.2.3 TRUE)
git(-c tag.gpgsign=false tag v1.2.4)
probe("${TEST_ROOT}/owner" unused FALSE)
git(tag -d v1.2.4)
git(tag -d v1.2.3)
git(-c user.name=fixture -c user.email=fixture@example.invalid -c tag.gpgsign=false tag -a v1.2.3 -m fixture)
probe("${TEST_ROOT}/owner" unused FALSE)
git(tag -d v1.2.3)
git(symbolic-ref refs/tags/v2.0.0 HEAD)
probe("${TEST_ROOT}/owner" unused FALSE)
# An enclosing checkout must never supply identity to an extracted subproject.
foreach(path "${TEST_ROOT}/source" "${TEST_ROOT}/owner/sub")
  probe("${path}" unused FALSE)
  file(WRITE "${path}/VERSION" "2.3.4\n")
  file(SHA256 "${path}/VERSION" digest)
  file(WRITE "${path}/RELEASE_MANIFEST" "${digest}  VERSION\n")
  probe("${path}" 2.3.4 TRUE)
  probe("${path}" unused FALSE -DKNURL_CANDIDATE_VERSION=9.9.9)
  file(WRITE "${path}/VERSION" "2.3.5\n")
  probe("${path}" unused FALSE)
endforeach()
