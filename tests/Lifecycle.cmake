cmake_minimum_required(VERSION 3.24)
include("${ROTMOS_ROOT}/cmake/OwnedPaths.cmake")
rotmos_require_owned_path("${TEST_ROOT}" "Lifecycle fixture")
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/release/cmake")
function(reject pattern)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if(code EQUAL 0 OR NOT "${log}${errors}" MATCHES "${pattern}")
    message(FATAL_ERROR "Expected rejection ${pattern}: ${ARGN}\n${log}${errors}")
  endif()
endfunction()
reject("usage: fuzz.sh" bash "${ROTMOS_ROOT}/scripts/fuzz.sh")
find_program(MAKE make REQUIRED)
reject("require TARGET=x86_64-linux-gnu" "${MAKE}" -C "${ROTMOS_ROOT}" memcheck TARGET=armhf-linux-musl)
reject("QEMU smoke requires" "${MAKE}" -C "${ROTMOS_ROOT}" qemu-smoke TARGET=arm64-apple-darwin)
reject("must use this checkout" bash "${ROTMOS_ROOT}/scripts/fuzz.sh" /not-owned smoke 1)
file(MAKE_DIRECTORY "${TEST_ROOT}/fuzz/smoke/default")
file(WRITE "${TEST_ROOT}/fuzz/rotmos_fuzz" "#!/bin/sh\nexit 0\n")
file(CHMOD "${TEST_ROOT}/fuzz/rotmos_fuzz" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
foreach(field saved_crashes saved_hangs)
  set(stats "saved_crashes : 0\nsaved_hangs : 0\n")
  string(REPLACE "${field} : 0" "${field} : 1" stats "${stats}")
  file(WRITE "${TEST_ROOT}/fuzz/smoke/default/fuzzer_stats" "${stats}")
  reject("${field}=1" bash "${ROTMOS_ROOT}/scripts/fuzz.sh" "${TEST_ROOT}/fuzz" smoke 1)
endforeach()
reject("AFL instrumentation belongs" "${CMAKE_COMMAND}" -S "${ROTMOS_ROOT}"
  -B "${TEST_ROOT}/instrumented-core" -DROTMOS_AFL=ON)
reject("CHECK_KIND must be" "${CMAKE_COMMAND}" -S "${ROTMOS_ROOT}/cmake/checks"
  -B "${TEST_ROOT}/checks" "-DROTMOS_BUILD=${ROTMOS_BUILD}" -DCHECK_KIND=invalid)
file(COPY "${ROTMOS_ROOT}/cmake/ReleaseCheck.cmake" "${ROTMOS_ROOT}/cmake/Version.cmake"
  "${ROTMOS_ROOT}/cmake/ReleaseArtifacts.cmake" "${ROTMOS_ROOT}/cmake/OwnedPaths.cmake"
  DESTINATION "${TEST_ROOT}/release/cmake")
file(WRITE "${TEST_ROOT}/release/.gitignore" "/build/\n/dist/\n")
execute_process(COMMAND "${ROTMOS_ROOT}/scripts/lifecycle/cpkt-toolchains.sh" targets
  OUTPUT_VARIABLE targets OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(MAKE_DIRECTORY "${TEST_ROOT}/release/scripts/lifecycle")
file(WRITE "${TEST_ROOT}/release/scripts/lifecycle/cpkt-toolchains.sh" "#!/bin/sh\ncat <<'TARGETS'\n${targets}\nTARGETS\n")
file(CHMOD "${TEST_ROOT}/release/scripts/lifecycle/cpkt-toolchains.sh"
  PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
find_program(GIT git REQUIRED)
function(git)
  execute_process(COMMAND "${GIT}" -C "${TEST_ROOT}/release" ${ARGV}
    RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Git fixture: ${log}${errors}")
  endif()
endfunction()
git(init -qb trunk)
git(add cmake .gitignore scripts)
git(-c user.name=fixture -c user.email=fixture@example.invalid -c commit.gpgsign=false commit -qm fixture)
git(symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/trunk)
git(checkout -qb feature)
reject("requires default branch" "${CMAKE_COMMAND}" -P "${TEST_ROOT}/release/cmake/ReleaseCheck.cmake")
git(checkout -q trunk)
file(APPEND "${TEST_ROOT}/release/cmake/Version.cmake" "\n# dirty\n")
reject("clean committed worktree" "${CMAKE_COMMAND}" -P "${TEST_ROOT}/release/cmake/ReleaseCheck.cmake")
git(checkout -- cmake/Version.cmake)
reject("verify-commit" "${CMAKE_COMMAND}" -P "${TEST_ROOT}/release/cmake/ReleaseCheck.cmake")
reject("forbids candidate" "${CMAKE_COMMAND}" -DROTMOS_CANDIDATE_VERSION=1.2.3
  -P "${TEST_ROOT}/release/cmake/ReleaseCheck.cmake")
# Positive signature/tag/artifact proof stays in the disposable fixture. It
# creates no workstation key, active release ref or published artifact.
find_program(SSH_KEYGEN ssh-keygen REQUIRED)
file(MAKE_DIRECTORY "${TEST_ROOT}/release/build/signing")
execute_process(COMMAND "${SSH_KEYGEN}" -q -t ed25519 -N "" -f "${TEST_ROOT}/release/build/signing/key"
  RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Cannot create fixture signing key")
endif()
file(READ "${TEST_ROOT}/release/build/signing/key.pub" public_key)
file(WRITE "${TEST_ROOT}/release/build/signing/allowed" "fixture@example.invalid ${public_key}")
git(config gpg.format ssh)
git(config user.signingkey "${TEST_ROOT}/release/build/signing/key")
git(config gpg.ssh.allowedSignersFile "${TEST_ROOT}/release/build/signing/allowed")
git(-c user.name=fixture -c user.email=fixture@example.invalid commit --allow-empty -S -q -m signed)
git(-c tag.gpgsign=false tag v1.2.3)
string(REPLACE "\n" ";" targets "${targets}")
foreach(target IN LISTS targets)
  set(binary "${TEST_ROOT}/release/build/${target}/release")
  if(target STREQUAL "x86_64-linux-gnu")
    set(binary "${TEST_ROOT}/release/build/release")
  endif()
  file(MAKE_DIRECTORY "${binary}/packages")
  set(name "librotmos-1.2.3-${target}.tar.gz")
  file(WRITE "${binary}/packages/${name}" "fixture ${target}")
  file(SHA256 "${binary}/packages/${name}" digest)
  file(WRITE "${binary}/packages/librotmos-1.2.3-${target}-BINARY-CHECKSUMS" "${digest}  ${name}\n")
endforeach()
set(products "${TEST_ROOT}/release/build/release/lua/tests/package/products")
file(MAKE_DIRECTORY "${products}")
set(inventory "")
foreach(name lua-rotmos-1.2.3.tar.gz lua-rotmos-1.2.3-1.rockspec lua-rotmos-1.2.3-1.src.rock)
  file(WRITE "${products}/${name}" "fixture ${name}")
  file(SHA256 "${products}/${name}" digest)
  string(APPEND inventory "${digest}  ${name}\n")
endforeach()
file(WRITE "${products}/lua-rotmos-1.2.3-CHECKSUMS" "${inventory}")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${TEST_ROOT}/release/cmake/ReleaseArtifacts.cmake"
  RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Signed fixture artifact gate failed: ${log}${errors}")
endif()
set(final "${TEST_ROOT}/release/dist/release-v1.2.3")
file(STRINGS "${final}/CHECKSUMS" inventory)
list(LENGTH inventory count)
if(NOT count EQUAL 10)
  message(FATAL_ERROR "Incomplete final release inventory")
endif()
foreach(entry IN LISTS inventory)
  string(SUBSTRING "${entry}" 0 64 expected)
  string(SUBSTRING "${entry}" 66 -1 name)
  file(SHA256 "${final}/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Final artifact bytes do not match: ${name}")
  endif()
endforeach()
reject("already exists" "${CMAKE_COMMAND}" -P "${TEST_ROOT}/release/cmake/ReleaseArtifacts.cmake")
file(REMOVE_RECURSE "${final}")
file(APPEND "${TEST_ROOT}/release/build/release/packages/librotmos-1.2.3-x86_64-linux-gnu.tar.gz" "corrupt")
reject("Final SDK inventory mismatch" "${CMAKE_COMMAND}" -P "${TEST_ROOT}/release/cmake/ReleaseArtifacts.cmake")
