cmake_minimum_required(VERSION 3.21)
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/project/vendor/kore/src"
  "${TEST_ROOT}/project/patches/kore" "${TEST_ROOT}/project/cmake")
file(COPY "${ROTMOS_ROOT}/Makefile" DESTINATION "${TEST_ROOT}/project")
file(MAKE_DIRECTORY "${TEST_ROOT}/project/scripts")
file(COPY "${ROTMOS_ROOT}/scripts/lifecycle" DESTINATION "${TEST_ROOT}/project/scripts")
file(WRITE "${TEST_ROOT}/project/CMakeLists.txt"
  "cmake_minimum_required(VERSION 3.24)\nproject(source_fixture LANGUAGES NONE)\ninclude(cmake/KoreSources.cmake)\nrotmos_add_kore_sources(\"\${CMAKE_CURRENT_SOURCE_DIR}\" \"\${CMAKE_BINARY_DIR}/kore\")\n")
file(COPY "${ROTMOS_ROOT}/cmake/PrepareKore.cmake" "${ROTMOS_ROOT}/cmake/KoreSources.cmake"
  "${ROTMOS_ROOT}/cmake/OwnedPaths.cmake" DESTINATION "${TEST_ROOT}/project/cmake")
file(WRITE "${TEST_ROOT}/project/vendor/kore.revision"
  "0123456789012345678901234567890123456789\n")
file(WRITE "${TEST_ROOT}/project/vendor/kore.url" "unused local fixture\n")
file(WRITE "${TEST_ROOT}/project/vendor/kore/src/kore.c" "upstream\n")
set(patch "${TEST_ROOT}/project/patches/kore/change.patch")
file(WRITE "${patch}" "--- a/src/kore.c\n+++ b/src/kore.c\n@@ -1 +1 @@\n-upstream\n+first\n")
file(WRITE "${TEST_ROOT}/project/patches/kore/series" "change.patch\n")

function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result
    OUTPUT_VARIABLE log ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Command failed: ${ARGV}\n${log}${error}")
  endif()
endfunction()
set(binary "${TEST_ROOT}/project/build/debug")
run("${CMAKE_COMMAND}" -S "${TEST_ROOT}/project" -B "${binary}" -DBUILD_TESTING=OFF)
run("${CMAKE_COMMAND}" --build "${binary}" --parallel 1)
set(output "${binary}/kore/src/kore.c")
file(READ "${output}" contents)
if(NOT contents STREQUAL "first\n")
  message(FATAL_ERROR "Initial build did not apply the fixture patch")
endif()

# An unchanged build must not replay patches or overwrite generated state.
file(WRITE "${binary}/kore/incremental-marker" "preserve\n")
run("${CMAKE_COMMAND}" --build "${binary}" --parallel 1)
if(NOT EXISTS "${binary}/kore/incremental-marker")
  message(FATAL_ERROR "An unchanged build repeated source preparation")
endif()

# Ensure even coarse filesystem timestamp resolution can distinguish the edit.
run("${CMAKE_COMMAND}" -E sleep 1)
file(WRITE "${patch}" "--- a/src/kore.c\n+++ b/src/kore.c\n@@ -1 +1 @@\n-upstream\n+revised\n")
run("${CMAKE_COMMAND}" --build "${binary}" --parallel 1)
file(READ "${output}" contents)
if(NOT contents STREQUAL "revised\n" OR EXISTS "${binary}/kore/incremental-marker")
  message(FATAL_ERROR "Editing a patch did not rebuild the prepared tree")
endif()
run("${CMAKE_COMMAND}" -E sleep 1)
file(WRITE "${TEST_ROOT}/project/patches/kore/series" "# no patches\n")
run("${CMAKE_COMMAND}" --build "${binary}" --parallel 1)
file(READ "${output}" contents)
if(NOT contents STREQUAL "upstream\n")
  message(FATAL_ERROR "Editing series did not restore pristine sources")
endif()
run("${CMAKE_COMMAND}" -E sleep 1)
file(WRITE "${TEST_ROOT}/project/vendor/kore/src/kore.c" "new upstream\n")
run("${CMAKE_COMMAND}" --build "${binary}" --parallel 1)
file(READ "${output}" contents)
if(NOT contents STREQUAL "new upstream\n")
  message(FATAL_ERROR "Changing the upstream snapshot did not rebuild the prepared tree")
endif()

# Full clean removes hidden local outputs as well as ordinary generated files.
file(MAKE_DIRECTORY "${TEST_ROOT}/project/dist" "${TEST_ROOT}/project/.cache")
foreach(directory build dist .cache)
  file(WRITE "${TEST_ROOT}/project/${directory}/.hidden" "generated\n")
endforeach()
find_program(MAKE_EXECUTABLE NAMES gmake make REQUIRED)
run("${MAKE_EXECUTABLE}" -C "${TEST_ROOT}/project" clean "CMAKE=${CMAKE_COMMAND}")
foreach(directory build dist .cache)
  if(EXISTS "${TEST_ROOT}/project/${directory}")
    message(FATAL_ERROR "Full clean retained ${directory}")
  endif()
endforeach()
if(NOT EXISTS "${TEST_ROOT}/project/vendor/kore/src/kore.c")
  message(FATAL_ERROR "Full clean removed upstream sources")
endif()
