cmake_minimum_required(VERSION 3.24)
include("${ROTMOS_ROOT}/cmake/OwnedPaths.cmake")
rotmos_require_owned_path("${TEST_ROOT}" "Source input fixture")
file(REMOVE_RECURSE "${TEST_ROOT}")
set(owner "${TEST_ROOT}/owner")
file(MAKE_DIRECTORY "${owner}/cmake" "${owner}/lua/cmake" "${owner}/assets" "${TEST_ROOT}/borrowed")
file(COPY "${ROTMOS_ROOT}/cmake/OwnedPaths.cmake" "${ROTMOS_ROOT}/cmake/Version.cmake"
  DESTINATION "${owner}/cmake")
file(COPY "${ROTMOS_ROOT}/lua/cmake/Package.cmake" DESTINATION "${owner}/lua/cmake")
file(COPY "${ROTMOS_ROOT}/lua/lua-rotmos.rockspec.in" DESTINATION "${owner}/lua")
file(WRITE "${owner}/LICENSE" "fixture\n")
file(WRITE "${owner}/assets/owned" "owned\n")
set(inputs "VERSION\nLICENSE\nassets/owned\ncmake/OwnedPaths.cmake\ncmake/Version.cmake\nlua/cmake/Package.cmake\nlua/lua-rotmos.rockspec.in\nlua/source-manifest.txt\n")
file(WRITE "${owner}/lua/source-manifest.txt" "${inputs}")
find_program(GIT git REQUIRED)
function(git)
  execute_process(COMMAND "${GIT}" -C "${owner}" ${ARGV}
    RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Git fixture: ${log}${errors}")
  endif()
endfunction()
git(init -q)
git(add LICENSE assets cmake lua)
git(-c user.name=fixture -c user.email=fixture@example.invalid -c commit.gpgsign=false commit -qm fixture)
function(package success pattern)
  execute_process(COMMAND "${CMAKE_COMMAND}" -P "${owner}/lua/cmake/Package.cmake"
    RESULT_VARIABLE code OUTPUT_VARIABLE log ERROR_VARIABLE errors)
  if((success AND NOT code EQUAL 0) OR
      (NOT success AND (code EQUAL 0 OR NOT "${log}${errors}" MATCHES "${pattern}")))
    message(FATAL_ERROR "Unexpected source packaging result: ${log}${errors}")
  endif()
endfunction()
package(TRUE "")
file(WRITE "${owner}/private-untracked" "do not ship\n")
file(APPEND "${owner}/lua/source-manifest.txt" "private-untracked\n")
package(FALSE "tracked")
file(WRITE "${owner}/lua/source-manifest.txt" "${inputs}")
file(REMOVE_RECURSE "${owner}/assets")
file(WRITE "${TEST_ROOT}/borrowed/owned" "borrowed\n")
file(CREATE_LINK "${TEST_ROOT}/borrowed" "${owner}/assets" SYMBOLIC)
package(FALSE "symlink")
