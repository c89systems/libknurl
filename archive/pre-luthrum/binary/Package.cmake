cmake_minimum_required(VERSION 3.24)
message(FATAL_ERROR "Archived executable package: deferred until Luthrum; only C SDKs are released")
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
include("${root}/cmake/OwnedPaths.cmake")
include("${root}/cmake/Privacy.cmake")
knurl_require_owned_path("${BUILD_DIR}" "Executable build")
include("${BUILD_DIR}/binary-build.cmake")
if(NOT PRODUCT_ROOT STREQUAL root OR NOT PRODUCT_BINARY STREQUAL BUILD_DIR OR
    NOT PRODUCT_TARGET MATCHES "^(x86_64|aarch64)-linux-musl$")
  message(FATAL_ERROR "Executable package belongs to another build")
endif()
set(work "${BUILD_DIR}/package-stage")
set(package "knurl-${PRODUCT_VERSION}-${PRODUCT_TARGET}")
set(output "${BUILD_DIR}/packages")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/${package}" "${output}")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Executable package command failed: ${ARGV}\n${stdout}${stderr}")
  endif()
endfunction()
run("${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${work}/${package}")
set(binary "${work}/${package}/bin/knurl")
run("${PRODUCT_STRIP}" --strip-all "${binary}")
execute_process(COMMAND "${PRODUCT_READELF}" -h -l -d "${binary}" OUTPUT_VARIABLE elf COMMAND_ERROR_IS_FATAL ANY)
if(elf MATCHES "INTERP|NEEDED|RPATH|RUNPATH|DYNAMIC" OR
    NOT elf MATCHES "EXEC" OR
    (PRODUCT_TARGET STREQUAL "x86_64-linux-musl" AND NOT elf MATCHES "Advanced Micro Devices X86-64") OR
    (PRODUCT_TARGET STREQUAL "aarch64-linux-musl" AND NOT elf MATCHES "AArch64"))
  message(FATAL_ERROR "Executable must be static ELF of the declared architecture")
endif()
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${work}/${package}" "${work}/${package}/*")
list(SORT files)
set(manifest "")
foreach(path IN LISTS files)
  if(IS_SYMLINK "${work}/${package}/${path}")
    message(FATAL_ERROR "Unexpected executable payload symlink")
  endif()
  knurl_verify_private_bytes("${work}/${package}/${path}")
  file(SHA256 "${work}/${package}/${path}" digest)
  string(APPEND manifest "${digest}  ${path}\n")
endforeach()
file(WRITE "${work}/${package}/share/doc/knurl/MANIFEST" "${manifest}")
find_program(TAR NAMES gtar tar REQUIRED)
find_program(GZIP gzip REQUIRED)
run("${TAR}" --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner
  --mode=u=rwX,go=rX --format=ustar -C "${work}" -cf "${work}/product.tar" "${package}")
execute_process(COMMAND "${GZIP}" -n -c "${work}/product.tar" OUTPUT_FILE "${output}/${package}.tar.gz" COMMAND_ERROR_IS_FATAL ANY)
file(READ "${output}/${package}.tar.gz" gzip_header LIMIT 8 HEX)
if(NOT gzip_header STREQUAL "1f8b080000000000")
  message(FATAL_ERROR "Executable gzip header contains nondeterministic metadata")
endif()
# Verify the extracted final bytes, not only the staging tree.
file(MAKE_DIRECTORY "${work}/relocated")
run("${TAR}" -xzf "${output}/${package}.tar.gz" -C "${work}/relocated")
set(prefix "${work}/relocated/${package}")
foreach(path IN LISTS files)
  file(SHA256 "${work}/${package}/${path}" expected)
  file(SHA256 "${prefix}/${path}" actual)
  if(NOT expected STREQUAL actual)
    message(FATAL_ERROR "Packaged bytes changed: ${path}")
  endif()
endforeach()
set(program "${prefix}/bin/knurl")
if(PRODUCT_EMULATOR)
  list(PREPEND program "${PRODUCT_EMULATOR}")
endif()
execute_process(COMMAND ${program} --version RESULT_VARIABLE status OUTPUT_VARIABLE version)
if(NOT status EQUAL 0 OR NOT version STREQUAL "knurl ${PRODUCT_VERSION}\n")
  message(FATAL_ERROR "Relocated executable version mismatch: ${status}/${version}")
endif()
run("${CMAKE_COMMAND}" "-DKNURL=${prefix}/bin/knurl" "-DWORK=${work}/cli"
  "-DROOT=${root}" "-DEMULATOR=${PRODUCT_EMULATOR}" -P "${root}/binary/tests/CLI.cmake")
file(SHA256 "${output}/${package}.tar.gz" digest)
file(WRITE "${output}/${package}-BINARY-CHECKSUMS" "${digest}  ${package}.tar.gz\n")
message(STATUS "Verified executable tarball: ${output}/${package}.tar.gz")
