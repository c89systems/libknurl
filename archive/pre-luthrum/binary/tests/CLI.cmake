cmake_minimum_required(VERSION 3.24)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}" "${WORK}/www" "${WORK}/dav")
set(run "${KNURL}")
if(EMULATOR)
  list(PREPEND run "${EMULATOR}")
endif()
function(check code pattern)
  execute_process(COMMAND ${run} ${ARGN} WORKING_DIRECTORY "${WORK}"
    TIMEOUT 10 RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result EQUAL code OR NOT "${output}${errors}" MATCHES "${pattern}")
    message(FATAL_ERROR "${ARGN}: wanted ${code}/${pattern}, got ${result}: ${output}${errors}")
  endif()
endfunction()
check(0 "knurl [0-9]+[.][0-9]+[.][0-9]+" --version)
check(0 "Usage: knurl" --help)
check(2 "Usage: knurl")
check(2 "Usage: knurl" --unknown)
check(2 "Usage: knurl" --check)
check(1 "cannot open" --check absent.lua)
file(WRITE "${WORK}/bad.lua" "return 42\n")
check(1 "must return a Knurl server" --check bad.lua)
file(WRITE "${WORK}/bad.lua" "this is not Lua\n")
check(1 "syntax error" --check bad.lua)
file(WRITE "${WORK}/valid.lua" [=[
local k=require('knurl')
assert(arg[0]=='valid.lua' and type(arg[-1])=='string')
local curl=require('curl')
local json=require('lonejson')
local log=require('pslog').new_json()
assert(type(curl.version())=='string' and json.decode_value('{"a":1}').a==1)
local s=assert(k.server{port=0,logger=log})
local c=assert(s:effective_config())
assert(c.autoblock.enabled and c.workers.count==1 and c.workers.affinity_disabled)
assert(c.http.hide_server_errors)
assert(c.timeouts.tls_handshake.milliseconds==10000)
assert(c.timeouts.deferred_response.milliseconds==30000 and not c.timeouts.deferred_response.disabled)
assert(s:get('/',function() return 'ok' end))
local other=assert(k.server{port=0,profile='default',workers={count=2},timeouts={tls_handshake={disabled=true}}})
local d=assert(other:effective_config())
assert(not d.autoblock.enabled and d.workers.count==2 and d.timeouts.tls_handshake.disabled)
assert(other:close())
return s
]=])
check(0 "" --check valid.lua)
check(0 "" --dump-examples)
foreach(name static proxy webdav combined)
  file(READ "${WORK}/knurl-example-${name}.lua" actual)
  file(READ "${ROOT}/binary/examples/knurl-example-${name}.lua" expected)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Dumped example differs: ${name}")
  endif()
endforeach()
foreach(name static proxy webdav)
  check(0 "" --check "knurl-example-${name}.lua")
endforeach()
check(1 "db-ip.com/db/download/ip-to-country-lite" --check knurl-example-combined.lua)
check(1 "File exists" --dump-examples)
file(REMOVE "${WORK}/knurl-example-static.lua")
check(1 "File exists" --dump-examples)
if(EXISTS "${WORK}/knurl-example-static.lua")
  message(FATAL_ERROR "Failed example dump did not roll back")
endif()
file(REMOVE "${WORK}/knurl-example-proxy.lua")
file(CREATE_LINK "${WORK}/valid.lua" "${WORK}/knurl-example-static.lua" SYMBOLIC)
check(1 "File exists" --dump-examples)
check(0 "" --check valid.lua)
check(1 "opening example directory" --dump-examples absent)
