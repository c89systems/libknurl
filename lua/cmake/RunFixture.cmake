cmake_minimum_required(VERSION 3.24)
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BINARY}" --prefix "${PREFIX}" RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Lua fixture install failed: ${log}${errors}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
  "${CMAKE_CURRENT_LIST_DIR}/../rotmos.meta.lua"
  "${PREFIX}/share/lua/5.5/rotmos.meta.lua" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Installed Lua editor metadata differs from the shipped source")
endif()
set(arguments "${SCRIPT}" "${PREFIX}")
if(DEFINED WORKSPACE)
  include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/OwnedPaths.cmake")
  rotmos_require_owned_path("${WORKSPACE}" "Lua fixture workspace")
  cmake_path(NORMAL_PATH BINARY)
  cmake_path(NORMAL_PATH WORKSPACE)
  cmake_path(IS_PREFIX BINARY "${WORKSPACE}" NORMALIZE owned)
  if(NOT owned OR WORKSPACE STREQUAL BINARY)
    message(FATAL_ERROR "Fixture workspace must be a descendant of its owned build directory")
  endif()
  file(REMOVE_RECURSE "${WORKSPACE}")
  file(MAKE_DIRECTORY "${WORKSPACE}/static" "${WORKSPACE}/cache")
  list(APPEND arguments "${WORKSPACE}")
endif()
execute_process(COMMAND ${RUNNER} "${HOST}" ${arguments} RESULT_VARIABLE result)
if(DEFINED WORKSPACE)
  file(REMOVE_RECURSE "${WORKSPACE}")
endif()
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Lua fixture failed: ${result}")
endif()
