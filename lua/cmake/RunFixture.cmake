cmake_minimum_required(VERSION 3.24)
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BINARY}" --prefix "${PREFIX}" RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Lua fixture install failed: ${log}${errors}")
endif()
execute_process(COMMAND "${HOST}" "${SCRIPT}" "${PREFIX}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Lua fixture failed: ${result}")
endif()
