cmake_minimum_required(VERSION 3.24)
get_filename_component(rotmos_root "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
include("${rotmos_root}/cmake/OwnedPaths.cmake")
if(NOT OUTPUT_DIR)
  set(OUTPUT_DIR "${rotmos_root}/dist")
endif()
rotmos_require_owned_path("${OUTPUT_DIR}" "Lua package output")
set(work "${rotmos_root}/build/lua-package")
rotmos_require_owned_path("${work}" "Lua package staging")
find_program(TAR NAMES gtar tar REQUIRED)
find_program(GZIP gzip REQUIRED)
find_program(ZIP zip REQUIRED)
find_program(TOUCH touch REQUIRED)
include("${rotmos_root}/cmake/Version.cmake")
rotmos_version("${rotmos_root}" rotmos_version)
set(package "lua-rotmos-${rotmos_version}")
set(rockspec "${package}-1.rockspec")
set(archive "${package}.tar.gz")
set(rock "${package}-1.src.rock")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/stage/${package}" "${work}/payload" "${OUTPUT_DIR}")
file(STRINGS "${rotmos_root}/lua/source-manifest.txt" inputs)
list(FILTER inputs EXCLUDE REGEX "^[ \t]*$")
set(unique ${inputs})
list(REMOVE_DUPLICATES unique)
if(NOT unique STREQUAL inputs)
  message(FATAL_ERROR "Duplicate Lua source-manifest input")
endif()
set(manifest "")
foreach(input IN LISTS inputs)
  if(input MATCHES "(^/|(^|/)[.][.](/|$))" OR
      (NOT input STREQUAL "VERSION" AND NOT EXISTS "${rotmos_root}/${input}") OR IS_SYMLINK "${rotmos_root}/${input}")
    message(FATAL_ERROR "Invalid Lua source-manifest input: ${input}")
  endif()
  set(destination "${work}/stage/${package}/${input}")
  get_filename_component(directory "${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  if(input STREQUAL "VERSION")
    file(WRITE "${destination}" "${rotmos_version}\n")
  else()
    configure_file("${rotmos_root}/${input}" "${destination}" COPYONLY)
  endif()
  file(CHMOD "${destination}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
  if(input MATCHES "[.]sh$")
    file(CHMOD "${destination}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
      GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  endif()
  file(SHA256 "${destination}" digest)
  string(APPEND manifest "${digest}  ${input}\n")
endforeach()
file(WRITE "${work}/stage/${package}/RELEASE_MANIFEST" "${manifest}")
configure_file("${rotmos_root}/lua/lua-rotmos.rockspec.in"
  "${work}/payload/${rockspec}" @ONLY)
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Lua package command failed: ${ARGV}\n${output}${errors}")
  endif()
endfunction()
run("${TAR}" --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner
  --mode=u=rwX,go=rX --format=ustar -C "${work}/stage" -cf "${work}/source.tar" "${package}")
execute_process(COMMAND "${GZIP}" -n -c "${work}/source.tar"
  OUTPUT_FILE "${work}/payload/${archive}" RESULT_VARIABLE result ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Lua source compression failed: ${errors}")
endif()
file(CHMOD "${work}/payload/${archive}" "${work}/payload/${rockspec}"
  PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
# ZIP timestamps start in 1980. Normalize both nested payloads independently of
# staging timestamps/umask and omit extended workstation attributes.
run("${CMAKE_COMMAND}" -E env TZ=UTC "${TOUCH}" -t 198001010000
  "${work}/payload/${archive}" "${work}/payload/${rockspec}")
run("${CMAKE_COMMAND}" -E env TZ=UTC "${ZIP}" -X -q -j "${work}/payload/${rock}"
  "${work}/payload/${rockspec}" "${work}/payload/${archive}")
set(checksums "")
foreach(product "${archive}" "${rockspec}" "${rock}")
  file(SHA256 "${work}/payload/${product}" digest)
  string(APPEND checksums "${digest}  ${product}\n")
  configure_file("${work}/payload/${product}" "${OUTPUT_DIR}/${product}" COPYONLY)
endforeach()
file(WRITE "${OUTPUT_DIR}/${package}-CHECKSUMS" "${checksums}")
message(STATUS "Lua products: ${OUTPUT_DIR}/${package}-CHECKSUMS")
